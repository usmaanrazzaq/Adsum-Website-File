#banner .images {
	filter: progid:DXImageTransform.Microsoft.gradient(
		enabled='true',
		startColorstr={{ settings.gradient_color }},
		endColorstr={{ settings.bg_color }},
		GradientType=0
	); 
	z-index: 0;
}

#currencies .middle  {
    border-left: none;
}

<!-- fix IE "black box" problems with PNG images when opacity is being animated -->
#banner .images img {background:#efefef url(h300.png) repeat-x 0 -22px;}

