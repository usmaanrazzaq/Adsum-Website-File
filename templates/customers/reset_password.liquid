<div class="page-padding">

  <div class="page-title">
    Reset Account Password
  </div>
 
  <div style="font-size: 14px; padding-bottom: 10px;">
    Enter a new password for {{ email }}
  </div>


    {% form 'reset_customer_password' %}
      {{ form.errors | default_errors }}

      <div id="password" class="clearfix large_form">
        <label class="password-reset" for="password">New Password</label>
        <input type="password" value="" name="customer[password]" id="customer_password" class="password-input" size="16" />
      </div>
      <div id="password_confirm" class="clearfix large_form">
        <label class="password-reset" for="password_confirmation">Password Confirmation</label>
        <input type="password" value="" name="customer[password_confirmation]" id="customer_password_confirmation" class="password-input" size="16" />
      </div>
      <div class="action_bottom">
        <input class="btn reset-button" type="submit" value="Reset Password" />
      </div>
    {% endform %}

</div>