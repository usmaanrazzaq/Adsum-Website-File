<div class="page-padding">

  <div class="page-title">
    Activate Account
  </div>

  <div style="font-size: 12px;">
    Create your password to activate your account
  </div>
  
  <br/>
  <br/>
  <br/>
  
  <div class="create-customer-wrapper">
    {% form 'activate_customer_password' %}
      {{ form.errors | default_errors }}

      <div id="password" class="clearfix large_form">
        
        <input type="password" value="" name="customer[password]" id="customer_password" class="input-field" style="width: 100%;" />
        <br/>
        <label class="login" for="password">Password</label>
      </div>

    <br/>

      <div id="password_confirm" class="clearfix large_form">
        <input type="password" value="" name="customer[password_confirmation]" id="customer_password_confirmation" class="input-field" style="width: 100%;" />
        <br/>
        <label class="login" for="password_confirmation">Password Confirmation</label>
      </div>

    <br/>
    <br/>

    <input class="button-sign-in" type="submit" value="Activate Account" style="width: 100%;" />
    
    {% endform %}
  </div>
</div>
