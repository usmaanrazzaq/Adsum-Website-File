 <style>
   .fw22-title {
     font-size: 58px; font-weight: 600; letter-spacing: -0.04em;
   }
   .header-text {
     position: relative; max-width: 300px; margin: 0 auto; color: #fff; top: 60px; text-align: center; font-size: 11px;
   }
   video {
    object-fit: cover;
    width: 100vw;
    height: 100vh;
    top: 0;
    left: 0;
    display: block
  }
  video::-webkit-media-controls {
    display: none !important;
  }
  *::-webkit-media-controls-panel {
    display: none!important;
    -webkit-appearance: none;
  }
   .scrolldown {
     font-size: 11px; 
     background-color: white; 
     color: #000; 
     height: 5vh; 
     padding: 20px; 
     text-align: center; 
     display: flex; 
     align-items: center; 
     justify-content: center;
   }
   .lookbook-collection-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    column-gap: 10px;
    row-gap: 10px;
    padding: 20px 40px 40px 40px;
    max-width: 1800px;
    margin: 0 auto;
  }
   .fall-22-lookbook-header {
     height: 95vh; 
     width: 100%; 
    background-image: url('https://cdn.shopify.com/s/files/1/0664/2387/files/cover-9B3A0571.jpg?v=1664478397'); 
      /*  background-image: url('https://cdn.shopify.com/s/files/1/0664/2387/files/9B3A0602.jpg?v=1663955599'); */
     background-position: center top;                       
     background-size: cover;  
     margin-bottom: 0px;
   }
  .grid-1 {
    display: grid; 
    grid-template-columns: repeat(2, 1fr);
    column-gap: 0px;
    padding: 0px 240px;
    margin: 120px 0;
    justify-items: center;
    row-gap: 5px; 
    place-content: center;
  }
  .cell-1, .cell-2 {
    background-position: center;                       
    background-size: cover;  
    height: 75vh;
    width: 100%;
    display: flex;
  }
  .one, .three, .five, .seven, .nine, .eleven, .thirteen, .fifteen, .seventeen, .nineteen, .twentyone, .twentythree {
    opacity: 0;
    transform: translate3d(-55px, 0, 0px);
    transition: transform 1.2s cubic-bezier(0.165, 0.84, 0.44, 1) 0s, opacity 0.5s linear 0.1s;
  }
  .two, .four, .six, .eight, .ten, .twelve, .fourteen, .sixteen, .eighteen, .twenty, .twentytwo, .twentyfour {
    opacity: 0;
    transform: translate3d(55px, 0, 0px);
    transition: transform 1.2s cubic-bezier(0.165, 0.84, 0.44, 1) 0s, opacity 0.5s linear 0.1s;
  }
  .lookbook-caption {
    line-height: 14px;
    font-size: 10px;
    text-align: left;
    max-width: 75%;
    color: #fff;
    font-weight: 600;
    margin: 0 10px 8px 10px;
    align-self: flex-end;
  }
  .menu-to-white > .menu > .nav-link-wrapper > .first-level-link > a, 
  .menu-to-white > .menu > .nav-link-wrapper > .first-level-link > .dropdown-child > .second-level-link > a {
    color: #fff!important;
    fill: #fff!important;
    transition: all .3s ease-in-out;
  }
  #page-fall-22-lookbook .right-nav, 
  #page-fall-22-lookbook #eyebrow-cart, 
  #page-fall-22-lookbook .currency-picker {
    color:#fff;
  }
  #page-fall-22-lookbook select {
      width: auto; 
      vertical-align: inherit;
      cursor: pointer;
      -webkit-appearance: none;
      -moz-appearance: none;
      appearance: none;
      -webkit-user-select: none;
      -moz-user-select: none;
      -webkit-padding-end: 34px;
      -moz-padding-end: 34px;
      -webkit-padding-start: 0px;
      -moz-padding-start: 0px;
      background: url(https://cdn.shopify.com/s/files/1/0664/2387/files/adsum-down-arrow-white.png?7373984998795179158) no-repeat;
      background-size: 10px;
      background-position: calc(100% - 20px) 3px;
      background-repeat: no-repeat;
      background-color: transparent;
      border: 0px;
      border-radius: 0px;
      box-shadow: 0px 0px 0px rgba(0, 0, 0, 0);
      color: #000;
      font-size: 12px;
      font-weight: 400!important;
      margin: 0;
      overflow: hidden;
      padding-top: 0px;
      padding-bottom: 0px;
      text-overflow: ellipsis;
      white-space: nowrap;
      transition: all .3s ease-in-out;
      -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
  }
@media (max-width: 1400px) {
  .grid-1 {
    padding: 40px 40px;
  }
}
@media (max-width: 1000px) {
  .grid-1 {
    padding: 40px 0px;
  }
}
@media (max-width: 900px) {
  .cell-1, .cell-2 {
    height: 50vh;
  }
  .lookbook-collection-grid {
    grid-template-columns: repeat(2, 1fr);
    padding: 0px 10px 40px 10px;
  }
}
@media (max-width: 500px) {
  .fw22-title {
    font-size: 38px;
  }
  .fall-22-lookbook-header {
    height: 75vh; 
    width: 100%; 
    background-image: url('https://cdn.shopify.com/s/files/1/0664/2387/files/cover-mobile-9B3A0568.jpg?v=1664562268'); 
  }
  .grid-1 {
    margin: 0px;
  }
  .cell-1, .cell-2 {
    grid-column: span 2;
    height: 60vh;
  }
}
</style>

