<style>
  .community-header {
    font-size: 14px;
    max-width: 589px;
    line-height: 146%;
    padding-bottom: 100px;
  }
  .community-grid {
    max-width: 100%;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: min-content;
    column-gap: 20px;
    row-gap: 92px;
  }
  .bts-grid {
    max-width: 100%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: min-content;
    column-gap: 20px;
    row-gap: 92px;
  }
  .community-cell {
    display: flex;
    justify-content: top;
    grid-column: span 1;
    flex-direction: column;
  }
  .community-cell img {
    display: block; 
    width: 100%;
  }

  @media (max-width: 700px) {
    .community-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: min-content;
    }
    .community-header {
        font-size: 14px;
        padding-bottom: 90px;
    }
    .community-cell {
      grid-column: span 2;
  }
  
</style>

