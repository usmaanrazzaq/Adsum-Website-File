<div class="max-width-1100 awning-cover" style="opacity: 1;">
    <img class="center-single ss16-preview" src="https://cdn.shopify.com/s/files/1/0664/2387/files/Adsum_112120-37-optimized-vert.jpg?v=1606860191" alt="Sweat Tops and Outerwear">
