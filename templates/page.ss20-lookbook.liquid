<style>
  .ss20-lookbook-cover {
    margin-top: 100px;
  }
  .ss20-lookbook-caption {
    font-size: 10px; 
    padding-top: 8px; 
    line-height: 13px;
  }
  .ss20-lookbook-shop-btn,  .ss20-lookbook-shop-btn:active {
    background-color: #356935;
    color: #fff;
    border: 1px solid #356935;
      display: block;
      text-decoration: none!important;
      text-align: center;
      margin: 80px auto 0 auto;
      max-width: 300px;
      font-size: 16px;
      font-weight: 400;
      line-height: 21px;
      letter-spacing: 0px;
      padding: 40px 16px;
      cursor: pointer;
      -moz-transition: all .3s ease-in-out;
      -webkit-transition: all .3s ease-in-out;
      -o-transition: all .3s ease-in-out;
      -ms-transition: all .3s ease-in-out;
      transition: all .3s ease-in-out;
  }
  .ss20-lookbook-shop-btn:hover {
    background-color: white;
    color: #356935;
    border: 1px solid #356935;
      cursor: pointer;
      -moz-transition: all .3s ease-in-out;
      -webkit-transition: all .3s ease-in-out;
      -o-transition: all .3s ease-in-out;
      -ms-transition: all .3s ease-in-out;
      transition: all .3s ease-in-out;
  }
  @media (max-width: 900px) {   
    .ss20-lookbook-caption {
      padding: 8px 20px;
    }
    .ss20-lookbook-cover {
      margin-top: 0px;
    }
  }
</style>

{% include "loading" %}

<script type="text/javascript">
$(window).scroll(function() {    
    var scroll = $(window).scrollTop();

    if (scroll >= 10) {
        $(".index-scroll-arrow-img").addClass("hide3");
    } else {
        $(".index-scroll-arrow-img").removeClass("hide3");
    }
});
</script>


