<script type="text/javascript">
  $(window).scroll(function() {    
      var scroll = $(window).scrollTop();

      if (scroll >= 10) {
          $(".index-scroll-arrow").addClass("hide3");
      } else {
          $(".index-scroll-arrow").removeClass("hide3");
      }
  });
</script>
<script type="text/javascript">
	$(window).scroll(function() {	  
		  if ($(window).scrollTop() > 10 ){
			
			$('.ss17-story-arrow').addClass('hide3');
            $('.header-fullsite-fixed').addClass('hide3');
            $('.ss17-deschutes-wrapper').addClass('hide3');

			
		  } else {
			
			$('.ss17-story-arrow').removeClass('hide3');
            $('.header-fullsite-fixed').removeClass('hide3');
            $('.ss17-deschutes-wrapper').removeClass('hide3');
			
			};   	
	});
</script>
<script type="text/javascript">
  $(window).scroll(function() {
     $(".deschutes-secondary").addClass("hide4");
     $(".carousel-control").addClass("hide4");
     $(".footer_new4").addClass("hide4");
     if($(window).scrollTop() + $(window).height() > ($(document).height() - 20) ) {
         $(".deschutes-secondary").removeClass("hide4");
         $(".carousel-control").removeClass("hide4");
         $(".footer_new4").removeClass("hide4");
     }
  });
</script>
<script type="text/javascript">
  $(document).ready(function(){
    window.setTimeout(function(){
        $(".index-scroll-arrow").addClass("visible");
    },2500);
});
</script>
              