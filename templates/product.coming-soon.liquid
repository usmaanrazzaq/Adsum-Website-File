<script type="text/javascript">  
  
// Prevent form submission without user selecting a size     
  $( "#first-form" ).submit(function( event ) {

      if ($('input:radio:checked').length > 0) {
        return;

      } else {

        var itemsize = $('form input[type=radio]:checked');

        $('.size-title').html('PLEASE SELECT A SIZE').addClass('reminder');     
        $('.content3').addClass('reminder').addClass("expanded");
        $('.product-size').addClass('no-size');

        event.preventDefault();
      }
  });

  $(window).scroll(function() {

      if ($(window).scrollTop() > 52 ){

          $('.product-info-column2').addClass('fixed2');

    } else {

      $('.product-info-column2').removeClass('fixed2');

      };   	
  });

  $(window).scroll(function() {

      if ($(window).scrollTop() > 200 ){

          $('.product-right2').addClass('fixed2');

    } else {

      $('.product-right2').removeClass('fixed2');

      };   	
  });

});
                             		
</script>
  
