<style>
  * {
    scroll-behavior: smooth;
  }
  .blog-link {
    text-align: center;
    font-size: 13px;
    max-width: 420px;
    background-color: #fff;
    color: #000;
    padding: 10px 20px;
    margin: 0 auto;
    display: block;
    border: 1px solid #000;
    margin-bottom: 80px;
  }
  .blog-link:hover {
    background-color: #000;
    color: #fff;
  }
  .grid-container {
    grid-template-columns: repeat(12, 1fr);
    column-gap: 10px;
    display: grid;
    margin: 94px 40px 0 257px;
    scroll-behavior: smooth;
  }
  .caption-title {
    font-weight: 600;
    padding-bottom: 12px;
    max-width: 420px;
    line-height: 1.4em;
  }
  .caption-text{
    max-width: 420px;
    line-height: 1.4em;
  }
  .section-big-text{
    grid-column: span 6;
    font-size: 24px;
  }
  
  .full-container{
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-row: repeat(16, 1fr);
    min-height: 100vh;
    width: 100vw;
  }
  .full-image{
    grid-column: 1 / span 12;
    grid-row: 1 / span 16;
    z-index: 1;
    object-fit: cover;
    width: 100vw;
    height: 90vh;
  }
  .fullAnnotations{
    display: inline;
    z-index: 2;
    
  }
  .fullAnnotations1{
    grid-column: 4 / span 2;
    grid-row: 3 / span 1;
  }
  .fullAnnotations2{
    grid-column: 8 / span 2;
    grid-row: 7 / span 1;
  }
  
  .hero-image{
    grid-column: 6 / span 7;
    width: 100%;
    grid-row: span 6;
    max-height: calc(100vh - 124px);
    object-fit: cover;
  }
  .hero-title {
    font-size: 48px;
    margin-bottom: 20px;
  }
  .hero-text {
    grid-column: 1 / span 4;
    font-size: 12px;
  }
  .hero-button {
    grid-column: 1 / span 2;
    position: sticky;
    top: 50px;
  }
  .hero-button-overview {
    margin: 41px 0 5px 0;
    font-weight: 600;
    grid-column: 1 / span 1;
    position: sticky;
    top: 60px;
    height: auto;
  }
  .hero-paragraph {
    line-height: 18px;
  }
  .section-header {
    font-weight: 600;
    grid-column: 1 / span 1;
    position: sticky;
    top: 60px;
    height: auto;
    padding-bottom: 40px;
  }
  .section-bullet {
    position: sticky;
    grid-column: 1 / span 4 ;
    margin-bottom: 10px;
    height: 15px;
    line-height: 15px;
  }
  .section-bullet a {
  }
  .section-bullet a:hover {
    color: grey;
    text-decoration: underline;
  }
  .section-header0 {
    top: 102px;
  }
  .section-bullet0 {
    top: 117px;
  }
  .section-header1{
    top: 211px;
  }
  .section-bullet1{
    top: 226px;
  }
  .section-bullet2{
    top: 241px;
  }
  .section-bullet3{
    top:256px;
  }
  .section-header2{
    top: 291px;
  }
  .section-bullet4{
    top: 306px;
  }
  .section-bullet5{
    top: 321px;
  }
    .section-bullet6{
    top: 336px;
  }

  .section-images{
    grid-column: 3 / span 10;
    grid-template-columns: repeat(6, 1fr);
    display: grid;
    column-gap: 10px;
    padding-bottom: 80px;
  }
  .three-across img{
    grid-column: span 2;
    width: 100%;
    margin-block: 10px;
  }
    .three-across a{
    grid-column: span 3;
    width: 100%;
    margin-block: 10px;
  }
  .one-across img{
    grid-column: span 4;
    height: 50vh;
    width: 100%;
    object-fit: cover;
  }

    @media (max-width: 900px) {
      .hero-title{
        font-size: 36px;
        font-weight: normal;
        margin-top: 20px;
        margin-bottom: 15px;
      }
      .hero-text{
        grid-column: 1 / span 12;
        font-size: 12px;
      }
      .hero-image{
          grid-column: 1 / span 12;
          grid-row: 1;
      }
      .hero-button{
        grid-column: 1 / span 4;
        position: inherit;
      }
      .grid-container{
        grid-template-columns: repeat(12, 1fr);
        column-gap: 0px;
        grid-row-gap: 0px;
        display: grid;
        margin: 50px 20px 0 20px; 
      }
      .section-images{
        grid-column: 1 / span 12;
        padding-bottom: 40px;
      }
      .section-header{
        position: initial;
        padding-bottom: 0px;
      }
      .section-header{
        position: initial;
        padding-bottom: 10px;
      }
      .section-bullet{
        position: static;
        height: 100%;
      }
      .hero-button-overview {
        position: initial;
      }
      .one-across img{
        grid-column: span 6;
        height: 25vh;
        width: 100%;
        object-fit: cover;
      }
        .three-across img{
        grid-column: span 3;
        width: 100%;
        margin-top: 0px;
      }
    }   
    @media (max-width: 400px) { 
      .blog-link {
        margin: 0 20px 80px;
      }
    }
</style>

