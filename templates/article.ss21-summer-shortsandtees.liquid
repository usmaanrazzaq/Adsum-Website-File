{% include "loading" %}

<style>
  .article-collection-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    column-gap: 16px;
    row-gap: 20px;
    padding: 20px 40px 40px 40px;
  }
  
  .graphics-article-title {
    display: block;
    text-align: center;
    font-size: 20px;
    padding: 43px 20px 0 20px;
    width: 100%;
    max-width: 440px;
    line-height: 26px;
    margin: 0 auto;
    opacity: 1;
    -moz-transition: all .3s ease-in-out;
    -webkit-transition: all .3s ease-in-out;
    -o-transition: all .3s ease-in-out;
    -ms-transition: all .3s ease-in-out;
    transition: all .3s ease-in-out;
  }
  
  .centered-article-text {
    font-size: 12px;
  }
  
  .blog-img-caption {
    top: 10px;
  }
  
  .gallery {
    min-height: 10px;
  }

  @media (max-width: 900px) {
    .graphics-article-title {
      font-size: 17px;
      line-height: 26px;
      text-align: left;
      padding: 80px 20px 0px;
      font-weight: 500;
      max-width: 580px;
    }  
    .article-collection-grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 16px;
      row-gap: 20px;
      padding: 20px;
    }
  }
</style>

