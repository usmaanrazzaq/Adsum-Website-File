      grid-template-columns: repeat(2, 1fr);
      column-gap: 16px;
      row-gap: 20px;
      padding: 20px;
    }
    .new-centered-article-text {
      padding-top: 140px!important;
    }
    .graphics-article-title {
      font-size: 18px;
      line-height: 26px;
      top: 67px;
      padding-top: 80px;
    }
    .cover-image {
      padding-top: 95px; 
      width: 100%;
    }
    .page-grid-1 {
      grid-template-columns: repeat(2, 1fr);
      padding: 80px 6px 0px;
