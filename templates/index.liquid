/* Global placement for the bento CTA - stays fixed within bounds */
.fw22-link--bento {
  position: absolute;
  left: 24px;
  right: 24px;
  bottom: 24px;
  width: auto;
  color: #000;
  text-decoration: none;
  border-radius: 4px;
  padding: 10px 0;
  line-height: 20px;
  z-index: 10;
  font-size: 14px;
}
.fw22-link--bento:hover { opacity: 0.7; }

/* Tablet and smaller */
@media (max-width: 768px) {
  .fw22-link--bento { 
    left: 16px; 
    right: 16px;
    bottom: 16px;
    font-size: 13px;
  }
}

/* Small screens */
@media (max-width: 480px) {
  .fw22-link--bento { 
    left: 12px; 
    right: 12px;
    bottom: 12px;
    font-size: 12px;
  }
}
</style>

