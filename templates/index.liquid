<div id="index-featured-products" class="index-blog-block-wrapper ">
  <div class="index-news-title">Featured</div>
  <div class="index-featured-grid">
    {% for product in collections.featured.products limit: 9 %}
      <div class="index-featured-item">
        <a href="{{ product.url | within: collection }}" title="{{ product.title | strip_html | escape }}">
          <div style="position: relative;">
            <img
              data-sizes="auto"
              src="{{ product.images.first | product_img_url: '1x1' }}"
              data-src="{{ product.images.first | product_img_url: '1024x1024' }}"
              data-srcset="
                {{ product.images.first | product_img_url: '600x600' }} 300w,
                {{ product.images.first | product_img_url: '1200x1200' }} 600w,
                {{ product.images.first | product_img_url: '1800x1800' }} 900w
              "
              alt="{{ product.title | strip_html | escape }}"
              class="lazyload"
              style="display: block; width: 100%; height: 100%;"
            >
            <img
              data-sizes="auto"
              src="{{ product.images[1] | product_img_url: '1x1' }}"
              data-src="{{ product.images[1] | product_img_url: '1024x1024' }}"
              data-srcset="
                {{ product.images[1] | product_img_url: '600x600' }} 300w,
                {{ product.images[1] | product_img_url: '1200x1200' }} 600w,
                {{ product.images[1] | product_img_url: '1800x1800' }} 900w
              "
              alt="{{ product.images[1].alt | escape }}"
              class="collection-product-hover lazyload"
            >
          </div>
          <div class="product_info_content">
            {% if product.available == true %}
              <div class="gallery-product-title">
                {{ product.title }}
              </div>
              <div class="gallery-product-price">
                {% if product.compare_at_price_max > product.price %}
                  <del class="sale-price">{{ product.compare_at_price_max | money }}</del>
                {% endif %}
                {{ product.price | money }}
              </div>
            {% endif %}
            {% if product.available == false %}
              <div class="sold-out">Sold Out</div>
            {% endif %}
          </div>
        </a>
      </div>
    {% endfor %}
  </div>
  <a href="/collections/all" class="index-more-link"> See All </a>
</div>

<div class="index-blog-block-wrapper" style="padding-bottom: 60px;">
  <div class="index-news-title">
    <a href="/blogs/news">The News</a>
  </div>
  <div class="blog-index-grid">
    {% for article in blogs.news.articles limit: 6 %}
      <div class="blog-index-item">
        <a href="{{ article.url }}">
          <div class="blog-image-index" style="background-image: url('{{ article | img_url: '1024x1024' }}')"></div>
          <div class="index-blog-title">
            {{ article.title }}
          </div>
          <div class="index-blog-body">
            {{ article.excerpt }}
          </div>
        </a>
      </div>
    {% endfor %}
  </div>
  <a href="/blogs/news" class="index-more-link"> See All The News </a>
</div>

