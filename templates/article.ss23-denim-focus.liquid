<style>
  * {
    scroll-behavior: smooth;
  }
  .blog-link {
    text-align: center;
    font-size: 13px;
    max-width: 420px;
    background-color: #fff;
    color: #000;
    padding: 10px 20px;
    margin: 0 auto;
    display: block;
    border: 1px solid #000;
    margin-bottom: 80px;
    margin-top: 40px;
  }
  .blog-link:hover {
    background-color: #000;
    color: #fff;
  }
  .grid-container {
    grid-template-columns: repeat(10, 1fr);
    column-gap: 10px;
    display: grid;
    margin: 94px 10vw 0 10vw;
    scroll-behavior: smooth;
  }
  .hero-image{
    width: 100%;
    grid-column: 4 / span 4;
  }
  .first-paragraph {
    grid-column: 1 / span 4;
    font-size: 18px;
    margin: 80px 0 120px;
    line-height: 1.3em;
    letter-spacing: .02em
  }
    .five-across{
      grid-column: span 10;
      display: grid;
      grid-template-columns: repeat(10, 1fr);
      column-gap: 10px;
      margin-top: 120px;
    }
      .two-across {
        grid-column: span 10;
        display: grid;
        grid-template-columns: repeat(10, 1fr);
        column-gap: 10px;
        margin: 40px 0px 0px 0px;
      } 
      .five-across img{
        width: 100%;
        grid-column: span 2;
      }
      .five-across .first-image{
        grid-column: 1 / span 2
      }
      .two-across img{
        width: 100%;
        grid-column: span 4;
      }
      .caption{
        padding: 0px 0 20px 0;
      }
      .two-across .image-1{
        grid-column: 1 / span 4;
      }
      .two-across .image-2 {
        grid-column: 7 / span 4;
      }
      .article-collection-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        column-gap: 6px;
        row-gap: 20px;
        padding: 0px 10vw 40px 10vw;
        max-width: 100%;
        margin: 0 auto;
      }
    @media (max-width: 900px) {
      .article-collection-grid {
        padding: 0px 20px 40px 20px;
      }
      .five-across .first-image{
        display: none;
      }
      .five-across img{
        grid-column: span 3;
      }
      .two-across{
        grid-column: span 12;
      }   
      .five-across{
      margin-top: 60px;
      grid-column: span 12;
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      column-gap: 10px;
      }  
      .hero-image{
        grid-column: 1 / span 12;
      }
      .first-paragraph{
        grid-column: 1 / span 9;
      }
        .two-across .image-1{
          grid-column: 1 / span 5;
        }
      .two-across .image-2{
        grid-column: 6 / span 5;
      }
      .grid-container{
        grid-template-columns: repeat(12, 1fr);
        column-gap: 0px;
        grid-row-gap: 0px;
        display: grid;
        margin: 50px 20px 0 20px; 
      }    
    @media (max-width: 400px) {
      .five-across img{
      grid-column: span 3;
      }
      .five-across .first-image {
          display: none;
      }    
      .first-paragraph{
        grid-column: 1 / span 10;
        font-size: 14px;
        margin: 40px 0 80px;
      }     
      .blog-link {
        margin: 0 20px 80px;
      }
    }
</style>

<div class="grid-container">

    <img class="hero-image" src="https://cdn.shopify.com/s/files/1/0664/2387/files/SS23-1-3-2.jpg?v=1678397836" alt="" />

  
