{% include "loading" %}

{% paginate collection.products by 39 %}

<h1 class="collection-title">{{ collection.title }}</h1>

{% if settings.collection_pagination %}
<small>Showing items {{ paginate.current_offset | plus: 1 }}-{% if paginate.next %}{{ paginate.current_offset | plus: paginate.page_size }}{% else %}{{ paginate.items }}{% endif %} of {{ paginate.items }}.</small>
{% endif %}

<div id="adsumspace">
<div id="products" class="gallery">
  
