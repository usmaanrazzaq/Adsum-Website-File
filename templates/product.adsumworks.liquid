<style>
  .shrink-svg2 {
    transform: translate3d(0, 0px, 0) scale(0.2)!important;
  }
  .adsumworks-svg-product {
    width: 100%; 
    position: fixed; 
    top: 0px; 
    padding: 20px;
    z-index: 1;
    opacity: 1;
    transform-origin: top center; /* add this in */
  }
  
  .product-page-table {
    width: 100%;
    padding: 0px;
    grid-template-columns: 50% 50%;
  }
  
  .image {
    padding-top: 0px;
    max-width: 100%;
    margin: 0 auto;
  }
  
  .product-page-image-column {
    width: 100%;
  }
  
  .product-info-column {
  
    text-align: center;
    padding-left: 40px;
    padding-right: 40px;
  }
  
  .main-product-description {
    margin: 0 auto;
    max-width: 420px;
  }
  
  .product-title2 {
    max-width: 100%;
  }
  
  .product-info-title {
    text-align: center;
    display: block;
    padding-right: 0px;
    width: 100%;
  }
  
  .product-info-variable2 {
    display: block;
    width: 100%;
    text-align: center;
    margin-right: 0px;
  }
  
  #product-description ul {
    list-style: none !important;
  }
  
  .product-sold-out {
    text-align: center;
}
  
