  </div>
  <div class="ss20-grid-left">
    <img src="https://cdn.shopify.com/s/files/1/0664/2387/files/adsum-watercolor-stamp-tee.jpg?v=1587505365" class="ss20-lookbook-img">
  </div>
  <div class="ss20-grid-right">
     <img src="https://cdn.shopify.com/s/files/1/0664/2387/files/adsum-drop2-stamp-tee.jpg?v=1587572140" class="ss20-lookbook-img">
