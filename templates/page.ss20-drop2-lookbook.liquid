<style>
  .ss20-grid {
    display: grid;
    width: 100%;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid #000;
    max-width: 1500px;
    margin: 0 auto;
  }
  
  .ss20-grid-left, .ss20-grid-right {
    grid-column: span 1;
    overflow: hidden;
  }
  
  .ss20-grid-left {
    border-right: 1px solid #000;
    border-bottom: 1px solid #000;
  }
  
  .ss20-grid-right {
    border-bottom: 1px solid #000;
  }
  
  .ss20-lookbook-caption {
    padding: 20px;
    border-bottom: 1px solid #000;
    font-size: 13px;
  }
  
  .caption-title {
    font-weight: 600;
    padding-bottom: 6px;
  }
    
  .caption-desc {
    line-height: 18px;
    max-width: 440px;
  }
  
  .ss20-lookbook-img {
    display: block;
    width: 100%;
    image-rendering: -webkit-optimize-contrast;
  }
  
  .sherbert-tee {
     background: url(https://cdn.shopify.com/s/files/1/0664/2387/files/adsum-drop2-hank-sherbert-tee.jpg?v=1587579465);
  }
  
  .purple-ucjacket {
    background: url(https://cdn.shopify.com/s/files/1/0664/2387/files/adsum-drop2-purple-uc-jacket.jpg?v=1587569382);
  }
  
  .stripe-shirt {
    background: url(https://cdn.shopify.com/s/files/1/0664/2387/files/ss20-drop2-stripe-shirt.jpg?v=1587574451);
  }
  
  .block-bg-img {
    overflow: hidden;
    background-repeat: no-repeat;
    background-position: center bottom;
    -webkit-background-size: cover;
    -moz-background-size: cover;
    -o-background-size: cover;
    background-size: cover;
  }
  
  .ss20-intro-block {
    height: 90vh; width: 100%; display: flex; align-items: center; justify-content: center;
  }
  
  .ss20-intro-img {
    display: block; width: 100%; max-width: 480px; margin: 0 auto; padding: 0 40px;
  }
  
  @media (min-width: 1500px) {
    .ss20-grid {
      border-right: 1px solid #000;
      border-left: 1px solid #000;
    }
  }
  
  @media (max-width: 900px) { 
    .ss20-grid-left, .ss20-grid-right {
      grid-column: span 1;
    }
  }
  
  @media (max-width: 500px) {
    .ss20-intro-block {
    height: 75vh;
    }
   .ss20-grid-left, .ss20-grid-right {
    grid-column: span 2;
   }
    .block-bg-img {
      min-height: 600px;
    }
    .ss20-grid-left {
      border-right: 0px solid #000;
    }
  }
  
</style>

{% include "loading" %}

