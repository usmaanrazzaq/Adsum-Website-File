    background-color: #000;
    color: #fff;
  }

  @media (max-width: 900px) {
    .graphics-article-title {
      font-size: 18px;
      line-height: 26px;
      top: 67px;
      padding-top: 80px;
    }
    .cover-image {
      padding-top: 145px; 
    }
    .page-grid-1 {
      grid-template-columns: repeat(2, 1fr);
      padding: 160px 0px 0px;
