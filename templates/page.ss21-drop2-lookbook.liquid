    }
    .page-grid-item-1 {
      grid-column: span 1;
    }
    .page-grid-item-2 {
      grid-column: span 1;
    }
    .caption {
      display: none;
      font-size: 4px;
      line-height: 6px;
      padding-top: 6px;
      padding-left: 6px;
    }
    .image-1 {
      padding: 20px;
    }
    .image-6 {
	  padding: 10px;
    }
    .image-5 {
      padding: 0 10px 0 0;
    }
    .image-2 {
      padding: 60px;
    }
    .image-9 {
      padding: 0 0 0 20px;
    }
    .image-10 {
      margin: 160px auto 0px;
    }
    .image-3 {
      grid-column: span 2;
    }
    .image-4 {
      grid-column: span 2;
      padding: 40px 10px 142px;
    }
    .image-11 {
