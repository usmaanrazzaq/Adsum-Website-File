  @media (max-width: 400px) {
    /* .page-grid-1 {
      padding: 80px 0 160px 0;
    } */
    .image-1, .image-12, .image-6, .image-5, .image-11, .image-7, .image-9, .image-2, .image-13, .image-8 {
      grid-column: span 2;
    }
    .image-9 {
      padding: 0px;
    }
    .image-2 {
      padding: 0px;
    }   
    .image-6 {
      padding: 30px;
    }
    .image-5 {
      padding: 0px;
    }
    .image-7 {
      padding: 90px;
    }
    .image-3 {
      padding: 0 40px 40px 40px;
    }
    .image-11 {
      padding: 0px;
    }
    .image-8 {
      padding: 40px;
    }
  }
</style>

