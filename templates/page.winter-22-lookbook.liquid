 <style>
  .grid-1 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    padding: 120px 200px;
    justify-items: center;
    row-gap: 5px;
    column-gap: 10px;
    max-width: 1400px;
    margin: 0 auto;
    place-content: center;
  }
   .cell-1, .cell-2 {
     grid-column: span 1;
     display: flex;
     align-self: center;
   }
   .solo-image {
     padding: 120px 0;
     max-width: 500px; display: block; margin: 0 auto;
   }
  .lookbook-caption {
    line-height: 14px;
    font-size: 10px;
    text-align: center;
    max-width: 300px;
    color: #000;
    display: block;
    font-weight: 400;
    align-self: auto;
    padding-top: 20px;
    margin: 0 auto;
  }
}
@media (max-width: 1400px) {
  .grid-1 {
    padding: 40px 40px;
  }
}
@media (max-width: 1000px) {
  .grid-1 {
    padding: 40px 0px;
  }
}
@media (max-width: 900px) {
  .lookbook-caption {
    grid-column: span 2;
  }
  .cell-1, .cell-2 {
  }
  .lookbook-collection-grid {
    grid-template-columns: repeat(2, 1fr);
    padding: 0px 10px 40px 10px;
  }
}
@media (max-width: 500px) {
  .solo-image:first-of-type {
        padding-top: 45px;
  }
  .fw22-title {
    font-size: 38px;
  }
  .fall-22-lookbook-header {
    height: 75vh; 
    width: 100%; 
    background-image: url('https://cdn.shopify.com/s/files/1/0664/2387/files/cover-mobile-9B3A0568.jpg?v=1664562268'); 
  }
  .grid-1 {
    margin: 0px;
  }
  .cell-1, .cell-2 {
    grid-column: span 2;
  }
}
</style>

