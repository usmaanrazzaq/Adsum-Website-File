<style>
.hero-button-overview{
  margin: 41px 0 5px 0;
font-weight: 600;
height: auto;
}
  .hero-paragraph{
    white-space: normal;
    font-size: 12px;
    line-height: 18px;
  }
  .hero-text{
    display: block;
  }
  .hero-title{
    font-size: 48px;
margin-bottom: 20px;
  }
  .section-bullet{

    margin-bottom: 10px;
    height: 15px;
    line-height: 15px;
  }

.scrollContainer::-webkit-scrollbar {
  width: 0px;
  height: 5px;
}

.scrollContainer::-webkit-scrollbar-track {
  background: #ffffff;
  margin-block: 0px;

}

.scrollContainer::-webkit-scrollbar-thumb{
  background: #ccc;

}

.scrollContainer::-webkit-scrollbar-thumb: hover{
  background: #ccc;

}

.scrollContainer > .hero-text{
  min-width: 500px;
  margin-right: 40px;
}

a > img, .scroll-image {
  height: 100%;
  max-width: none;
}



  .gridContainer{
    grid-template-columns: repeat(12, 1fr);
    column-gap: 20px;
    grid-row-gap: 20px;
    display: grid;
    margin: 94px 40px 0 240px;
  }


.bodyText{
  font-size: 13px;
  line-height: 21px;
}


.scrollContainer{
  grid-column: 1 / span 12;
  white-space: nowrap;
  overflow: scroll;
  width: 100%;
  display: flex;
  flex-direction: row;
  column-gap: 20px;
  height: 75vh;
  padding-bottom: 10px;
}
.panel{
  display: flex;
  flex-direction: row;
}

 @media (max-width: 1350px) {


 @media (max-width: 900px) {

.gridContainer{
    grid-template-columns: repeat(12, 1fr);
    column-gap: 0px;
    grid-row-gap: 10px;
    display: grid;
    margin: 50px 10px 0px 10px;
  }



</style>
