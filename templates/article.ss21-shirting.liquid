  <div class="featured-products-title">
    Featured Products
  </div>


<div id="products" class="article-collection-grid {{ collection.title | handleize }}">
  {% for product in collections.ss21-summer-shirting.products %}
  	<div class="collection-grid-item">
      <a href="{{ product.url | within: collection }}" title="{{ product.title | strip_html | escape }}">  
        <div style="position: relative;">
          <img data-sizes="auto"
               src="{{ product.images.first | product_img_url: '1x1' }}" 
               data-src="{{ product.images.first | product_img_url: '1024x1024' }}"
               data-srcset="{{ product.images.first | product_img_url: '600x600' }} 300w,
                            {{ product.images.first | product_img_url: '1200x1200' }} 600w,
                            {{ product.images.first | product_img_url: '1800x1800' }} 900w"
               alt="{{ product.title | strip_html | escape }}" class="lazyload" style="display: block; width: 100%; height: 100%;" />
          <img data-sizes="auto"
               src="{{ product.images[1] | product_img_url: '1x1' }}" 
               data-src="{{ product.images[1] | product_img_url: '1024x1024' }}" 
               data-srcset="{{ product.images[1] | product_img_url: '600x600' }} 300w,
                            {{ product.images[1] | product_img_url: '1200x1200' }} 600w,
                            {{ product.images[1] | product_img_url: '1800x1800' }} 900w"
               alt="{{ product.images[1].alt | escape }}" class="collection-product-hover lazyload"/>
        </div>
        <div class="product_info_content">
            {%if product.available == true %}
                <div class="gallery-product-title">
                    {{ product.title }}
                </div>
                <div class="gallery-product-price">
                    {% if product.compare_at_price_max > product.price %}
                        <del class="sale">{{ product.compare_at_price_max | money }}</del>
                    {% endif %}
                    {{ product.price | money }}
                </div>
            {% endif %}
            {%if product.available == false %}    
                <span style="color: red; text-decoration: uppercase;">Sold Out</span>
            {% endif %}
        </div>          
      </a>
    </div>
{% endfor %}
</div>
<!--
<a href="/collections/fw20" class="shop-button-photo-story">Shop All FW20</a>
-->
<div class="postnav">
  <a href="{{ blog.previous_article }}" class="btn" style="float: left">Previous Post</a>
    {% if blog.next_article %}
  <a href="{{ blog.next_article }}" class="btn" style="float: right">Next Post</a>
    {% endif %}
</div>

{% include "footer" %}

<script type="text/javascript">  
  $('.header-fullsite-fixed').addClass('header-fullsite').removeClass('header-fullsite-fixed');
</script>


<script type="text/javascript">
  $(document).ready(function(){
    window.setTimeout(function(){
        $(".index-scroll-arrow").addClass("visible");
    },2500);
});
</script>

<script type="text/javascript">
$(window).scroll(function() {    
    var scroll = $(window).scrollTop();

    if (scroll >= 10) {
        $(".index-scroll-arrow-img").addClass("hide4");
    } else {
        $(".index-scroll-arrow-img").removeClass("hide4");
    }
});
</script>