{% layout 'shop' %}

{% include "loading" %}

<div class="product-pdp-v2">
{% render 'breadcrumbs' %}

<div class="mobile-product">
  <h1 style="padding: 50px 20px 0; font-size: 14px; text-align:center;">{{ product.title }}</h1>
  <div style="padding: 4px 20px 14px 20px; font-size: 11px; text-align:center;">
    {% if product.compare_at_price_max > product.price %}
      <span style="text-decoration: line-through; padding-right: 10px; color: #ee5943!important;">{{ product.compare_at_price_max | money }}</span>
    {% endif %}
    {{ product.price | money }}
  </div>
  <div class="my-slider">
    <ul>
      {% for image in product.images %}
      <li>
        <div style="display: inline-block; width: 100%; height: 100%; vertical-align: middle;">
          <a class="fancybox crosshair" href="{{ image | product_img_url: 'master' }}" rel="images" title="{{ product.title | strip_html | escape }}">
            <img src="{{ image | product_img_url: '100x100' }}" data-src="{{ image | product_img_url: 'master' }}" alt="{{ product.title | escape }}" class="mobile-product-images lazyload" />
          </a>
        </div>
      </li>
      {% endfor %}
    </ul>
  </div>
  <div class="product-pdp-accordions-wrap desktop-hide product-pdp-mobile-drawers">
    {% render 'product-pdp-accordion-panels' %}
  </div>
</div>
         

<div class="product-page-table">
<div class="product-page-image-column mobile-hide">
<div class="product-page-image-column-mobile">
    {% for tag in product.tags %}
    {% if tag == 'show-image' %}
    {% if settings.show_product_show_image %}
    <a class="fancybox" href="{{ image | product_img_url: 'master' }}" title="{{ product.title | strip_html | escape }}"><img src="{{ 'product_show_image.png' | asset_url }}" class="product-hover-image" style="display: block; margin: 0 auto;" alt="{{ product.title | strip_html | escape }}"/></a>
    {% endif %}
    {% endif %}
    {% endfor %}

  {% for image in product.images %}
  <div class="image product-parallax-image product-pdp-gallery__img">
    <a class="fancybox crosshair" href="{{ image | product_img_url: 'master' }}" rel="images" title="{{ product.title | strip_html | escape }}">
      <img src="{{ image | product_img_url: '100x100' }}" data-src="{{ image | product_img_url: 'master' }}" alt="{{ product.title | escape }}" class="product-thumb product-parallax-img {% cycle 'first', '', '', 'last' %} lazyload" style="display: block; margin: 0 auto;"/>
    </a>
  </div>
  {% endfor %}
</div>
</div>

<div class="product-info-column">
  <div class="product-pdp-heading-row mobile-hide">
    <h1 class="product-title2 product-pdp-heading-row__title">{{ product.title }}</h1>
    <div class="product-pdp-heading-row__price">
      {% if product.compare_at_price_max > product.price %}
        <span class="product-pdp-heading-row__compare">{{ product.compare_at_price_max | money | remove: ' USD' }}</span>
      {% endif %}
      <span class="product-pdp-heading-row__current">{{ product.price | money | remove: ' USD' }}</span>
    </div>
  </div>

  {% if product.description != blank %}
  <div class="product-pdp-lede mobile-hide rte">
    {{ product.description }}
  </div>
  {% endif %}

  {% if product.tags contains 'exclusive' %}
    <div class="product-exclusive product-exclusive--pdp mobile-hide">
      Exclusive to Adsum
    </div>
  {% endif %}

  <div class="product-pdp-form-wrap">
    <div class="product-pdp-size-label">
      Select size:
    </div>
    <form id="first-form" class="product-pdp-form" action="/cart/add" method="post">
      {% if settings.product-qty %}
      <div id="product-qty-wrap">
        <label for="product-qty">
          Quantity:
        </label>
        <select id="product-qty" name="quantity">
          {% for i in (1..10) %}
          <option value="{{ forloop.index }}">{{ forloop.index }}</option>
          {% endfor %}
        </select>
      </div>
      {% endif %}

      <div class="product-size">
        {% assign first_color = product.variants.first.option1 %}
        {% assign has_multiple_colors = false %}
        {% for variant in product.variants %}
          {% if variant.option1 != first_color %}
            {% assign has_multiple_colors = true %}
            {% break %}
          {% endif %}
        {% endfor %}
        {% assign first_variant_radio_checked = false %}
        <ul id="variants">
          {% for variant in product.variants %}
          {% unless product.title contains 'Diamond Popover' and variant.title == 'BLACK / S' %}
          <li>
            {% if variant.available == true %}
            <input type="radio" name="id" value="{{variant.id}}" id="radio_{{variant.id}}" {% if first_variant_radio_checked == false %}{% assign first_variant_radio_checked = true %}checked{% endif %} />
            <label for="radio_{{variant.id}}">
              <div class='variant_title'>{% if has_multiple_colors %}{{ variant.title }}{% else %}{{ variant.title | split: ' / ' | last }}{% endif %}</div>
            </label>
            {% else %}
            <span class="sold_out">{% if has_multiple_colors %}{{ variant.title }}{% else %}{{ variant.title | split: ' / ' | last }}{% endif %}</span>
            {% endif %}
          </li>
          {% endunless %}
          {% endfor %}
        </ul>
      </div>

      <div class="product-pdp-cart-row">
        <div id="purchase-wrapper" class="product-pdp-purchase">
          {% if product.available == true %}
            <input type="submit" name="add" value="Add to cart" id="purchase" class="addtocart2 product-pdp-addtocart" />
          {% else %}
            <div class="product-sold-out product-pdp-soldout">SOLD OUT</div>
          {% endif %}
        </div>
      </div>
    </form>

    <div class="product-pdp-accordions-wrap mobile-hide">
      {% render 'product-pdp-accordion-panels' %}
    </div>

    <div id="product-description" class="description desktop-hide">
      {{ product.description }}
    </div>
  </div>
</div>
</div>

</div>

