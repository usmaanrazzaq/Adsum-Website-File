    .fancybox({
  		padding : 0 ,
        nextMethod : 'resizeIn',
        nextSpeed  : 250,
  		openSpeed : 'slow',
  		openEffect : 'fade',
  		aspectRatio : true,
		prevMethod : false,
  
  autoHeight : true,
  fitToView : false,
  maxWidth : "90%",
        
        helpers : {
			title : null  	
        }
    });


</script>


