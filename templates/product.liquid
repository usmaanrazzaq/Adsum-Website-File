      font-size: 13px;
      line-height: normal;
    }
    .product-pdp-v2 .product-pdp-accordions-wrap {
      margin-top: 18px;
      padding-bottom: 40px;
    }
    .product-pdp-v2 .product-title2.product-pdp-heading-row__title {
      padding: 0 !important;
    }
    .product-pdp-v2 .product-pdp-addtocart {
      width: calc(100% - 0px);
      max-width: 382px;
      margin-left: auto;
      margin-right: auto;
      display: block;
      box-sizing: border-box;
    }
    .product-pdp-v2 .product-pdp-purchase {
      max-width: 382px;
      margin-left: auto;
      margin-right: auto;
    }
    .product-pdp-v2 .product-pdp-form-wrap {
      margin-top: 40px;
    }
    .product-pdp-v2 .product-pdp-form #variants {
      gap: 15px;
    }
  }

  /* Sticky image scroll (desktop) */
  @media (min-width: 901px) {
    .product-image-scroll-track {
      position: relative;
    }
    .product-image-viewer {
      height: calc(100vh - 76px);
      overflow: hidden;
    }
    .product-image-viewer--fixed {
      position: fixed;
      top: 76px;
      z-index: 1;
    }
    .product-image-viewer--bottom {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
    }
    .product-image-viewer-inner {
      will-change: transform;
    }
    .product-image-viewer-inner .product-sticky-img {
      display: block;
      width: 100%;
      height: auto;
    }
    .product-info-column {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .product-info-column::-webkit-scrollbar {
      display: none;
    }
  }
  @media (min-width: 901px) and (prefers-reduced-motion: reduce) {
    .product-image-viewer-inner {
      transform: none !important;
      will-change: auto;
    }
    .product-image-viewer {
      overflow-y: auto;
    }
  }
</style>



{% layout 'shop' %}

{% include "loading" %}

<div class="product-pdp-v2">

<div class="mobile-product">
  <div class="product-pdp-mobile-gallery{% if product.images.size < 2 %} product-pdp-mobile-gallery--single{% endif %}">
    {% if product.images.size > 0 %}
      <div class="my-slider product-pdp-mobile-slider">
        <ul>
          {% for image in product.images %}
            <li>
              <div class="product-pdp-mobile-slide">
                <a class="fancybox crosshair" href="{{ image | product_img_url: 'master' }}" rel="images" title="{{ product.title | strip_html | escape }}">
                  <img src="{{ image | product_img_url: '100x100' }}" data-src="{{ image | product_img_url: 'master' }}" alt="{{ product.title | escape }}" class="mobile-product-images lazyload" {% if image.width and image.height %}width="{{ image.width }}" height="{{ image.height }}"{% endif %} />
                </a>
              </div>
            </li>
          {% endfor %}
        </ul>
      </div>
    {% elsif product.featured_image %}
      <div class="product-pdp-mobile-slide">
        <a class="fancybox crosshair" href="{{ product.featured_image | product_img_url: 'master' }}" rel="images" title="{{ product.title | strip_html | escape }}">
          <img src="{{ product.featured_image | product_img_url: '100x100' }}" data-src="{{ product.featured_image | product_img_url: 'master' }}" alt="{{ product.title | escape }}" class="mobile-product-images lazyload" />
        </a>
      </div>
    {% endif %}
  </div>
</div>
         

<div class="product-pdp-breadcrumb-row mobile-hide">
  {% render 'breadcrumbs' %}
</div>

<div class="product-page-table">
<div class="product-page-image-column mobile-hide">
<div class="product-image-scroll-track">
  <div class="product-image-viewer">
    <div class="product-image-viewer-inner">
      {% for tag in product.tags %}
      {% if tag == 'show-image' %}
      {% if settings.show_product_show_image %}
      <a class="fancybox" href="{{ image | product_img_url: 'master' }}" title="{{ product.title | strip_html | escape }}"><img src="{{ 'product_show_image.png' | asset_url }}" class="product-hover-image" style="display: block; margin: 0 auto;" alt="{{ product.title | strip_html | escape }}"/></a>
      {% endif %}
      {% endif %}
      {% endfor %}

      {% for image in product.images %}
      <div class="image product-pdp-gallery__img">
        <a class="fancybox crosshair" href="{{ image | product_img_url: 'master' }}" rel="images" title="{{ product.title | strip_html | escape }}">
          <img src="{{ image | product_img_url: '100x100' }}" data-src="{{ image | product_img_url: 'master' }}" alt="{{ product.title | escape }}" class="product-thumb product-sticky-img {% cycle 'first', '', '', 'last' %} lazyload" style="display: block; margin: 0 auto;"/>
        </a>
      </div>
      {% endfor %}
    </div>
  </div>
</div>
</div>

<div class="product-info-column">
  <div class="product-pdp-heading-row">
    <h1 class="product-title2 product-pdp-heading-row__title">{{ product.title }}</h1>
    <div class="product-pdp-heading-row__price">
      {% if product.available %}
        {% if product.compare_at_price_max > product.price %}
          <span class="product-pdp-heading-row__compare">{{ product.compare_at_price_max | money | remove: ' USD' }}</span>
        {% endif %}
        <span class="product-pdp-heading-row__current">{{ product.price | money | remove: ' USD' }}</span>
      {% else %}
        <span class="product-pdp-heading-row__soldout">SOLD OUT</span>
      {% endif %}
    </div>
  </div>

  {% assign pdp_lede = product.metafields.custom.pdp_lede %}
  {% assign pdp_lede_value = pdp_lede.value %}
  {% if pdp_lede_value != blank or product.description != blank %}
  <div class="product-pdp-lede rte">
    {% if pdp_lede_value != blank %}
      {% if pdp_lede.type == 'rich_text_field' %}
        {{ pdp_lede | metafield_tag }}
      {% else %}
        {{ pdp_lede_value | newline_to_br }}
      {% endif %}
    {% else %}
      {{ product.description }}
    {% endif %}
  </div>
  {% endif %}

  {% if product.tags contains 'exclusive' %}
    <div class="product-exclusive product-exclusive--pdp">
      Exclusive to Adsum
    </div>
  {% endif %}

  <div class="product-pdp-form-wrap">
    <div class="product-pdp-size-label">
      Select size:
    </div>
    <form id="first-form" class="product-pdp-form" action="/cart/add" method="post">
      {% if settings.product-qty %}
      <div id="product-qty-wrap">
        <label for="product-qty">
          Quantity:
        </label>
        <select id="product-qty" name="quantity">
          {% for i in (1..10) %}
          <option value="{{ forloop.index }}">{{ forloop.index }}</option>
          {% endfor %}
        </select>
      </div>
      {% endif %}

      <div class="product-size">
        {% assign first_color = product.variants.first.option1 %}
        {% assign has_multiple_colors = false %}
        {% for variant in product.variants %}
          {% if variant.option1 != first_color %}
            {% assign has_multiple_colors = true %}
            {% break %}
          {% endif %}
        {% endfor %}
        {% assign first_variant_radio_checked = false %}
        <ul id="variants">
          {% for variant in product.variants %}
          {% unless product.title contains 'Diamond Popover' and variant.title == 'BLACK / S' %}
          <li>
            {% if variant.available == true %}
            <input type="radio" name="id" value="{{variant.id}}" id="radio_{{variant.id}}" {% if first_variant_radio_checked == false %}{% assign first_variant_radio_checked = true %}checked{% endif %} />
            <label for="radio_{{variant.id}}">
              <div class='variant_title'>{% if has_multiple_colors %}{{ variant.title }}{% else %}{{ variant.title | split: ' / ' | last }}{% endif %}</div>
            </label>
            {% else %}
            <span class="sold_out">{% if has_multiple_colors %}{{ variant.title }}{% else %}{{ variant.title | split: ' / ' | last }}{% endif %}</span>
            {% endif %}
          </li>
          {% endunless %}
          {% endfor %}
        </ul>
      </div>

      <div class="product-pdp-cart-row">
        <div id="purchase-wrapper" class="product-pdp-purchase">
          {% if product.available == true %}
            <input type="submit" name="add" value="Add to cart" id="purchase" class="addtocart2 product-pdp-addtocart" />
          {% endif %}
        </div>
      </div>
    </form>

    <div class="product-pdp-accordions-wrap">
      {% render 'product-pdp-accordion-panels' %}
    </div>
  </div>
</div>
</div>

</div>

{% include "product-lightbox" %}

{% include 'related-products' %}




<script>
  jQuery(document).ready(function ($) {
    var $pdpSlider = $('.product-pdp-v2 .product-pdp-mobile-slider');
    if (!$pdpSlider.length) return;

    var sliderOpts = {
      speed: 1000,
      nav: true,
      animation: 'horizontal'
    };

    if ($pdpSlider.find('li').length > 1) {
      sliderOpts.arrows = {
        next: '<button type="button" class="unslider-arrow next product-pdp-mobile-slider__next" aria-label="Next slide"><span class="product-pdp-mobile-slider__next-inner" aria-hidden="true"></span></button>'
      };
    } else {
      sliderOpts.nav = false;
      sliderOpts.arrows = false;
    }

    $pdpSlider.unslider(sliderOpts);
  });
</script>



<script type="text/javascript">  
  
// Prevent form submission without user selecting a variant when size options exist
  $( "#first-form" ).submit(function( event ) {
      var $options = $('#first-form input:radio[name="id"]');
      if ($options.length === 0) {
        return;
      }
      if ($options.filter(':checked').length > 0) {
        return;
      }
      $('.product-pdp-size-label').html('PLEASE SELECT A SIZE').addClass('reminder');
      $('.product-size').addClass('no-size');
      event.preventDefault();
  });

  $(window).scroll(function() {

      if ($(window).scrollTop() > 52 ){

          $('.product-info-column2').addClass('fixed2');

    } else {

      $('.product-info-column2').removeClass('fixed2');

      };   	
  });

  $(window).scroll(function() {

      if ($(window).scrollTop() > 200 ){

          $('.product-right2').addClass('fixed2');

    } else {

      $('.product-right2').removeClass('fixed2');

      };   	
  });

  (function productStickyScroll() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var desktopMq = window.matchMedia('(min-width: 901px)');

    var track = document.querySelector('.product-image-scroll-track');
    var viewer = document.querySelector('.product-image-viewer');
    var inner = document.querySelector('.product-image-viewer-inner');
    var infoCol = document.querySelector('.product-info-column');
    if (!track || !viewer || !inner || !infoCol) return;

    var headerH = 76;
    var viewerH = 0, innerH = 0, maxTranslate = 0;
    var trackTop = 0, viewerWidth = 0, viewerLeft = 0;
    var infoWidth = 0, infoLeft = 0, infoHeight = 0;
    var ready = false;
    var ticking = false;
    var resizeTimer;
    var allImgs = inner.querySelectorAll('img');

    function forceLoadImages() {
      for (var i = 0; i < allImgs.length; i++) {
        var dataSrc = allImgs[i].getAttribute('data-src');
        if (dataSrc) {
          allImgs[i].className = allImgs[i].className.replace('lazyload', 'lazyloaded');
          allImgs[i].src = dataSrc;
        }
      }
    }

    var waitStart = Date.now();
    function waitForImages() {
      var allLoaded = true;
      for (var i = 0; i < allImgs.length; i++) {
        if (!allImgs[i].complete) { allLoaded = false; break; }
      }
      if (allLoaded || (Date.now() - waitStart > 10000)) {
        measure();
        update();
        ready = true;
      } else {
        setTimeout(waitForImages, 100);
      }
    }

    function measure() {
      viewer.className = 'product-image-viewer';
      viewer.style.width = '';
      viewer.style.left = '';
      viewer.style.position = '';
      viewer.style.top = '';
      viewer.style.bottom = '';

      infoCol.style.position = '';
      infoCol.style.top = '';
      infoCol.style.width = '';
      infoCol.style.left = '';
      infoCol.style.maxHeight = '';
      infoCol.style.overflowY = '';
      infoCol.style.marginTop = '';

      viewerH = window.innerHeight - headerH;
      innerH = inner.scrollHeight;

      if (innerH <= viewerH) {
        maxTranslate = 0;
        track.style.height = '';
        inner.style.transform = '';
        return;
      }

      maxTranslate = innerH - viewerH;
      track.style.height = innerH + 'px';

      var rect = track.getBoundingClientRect();
      trackTop = rect.top + (window.pageYOffset || document.documentElement.scrollTop);
      viewerWidth = rect.width;
      viewerLeft = rect.left;

      var infoRect = infoCol.getBoundingClientRect();
      infoWidth = infoRect.width;
      infoLeft = infoRect.left;
      infoHeight = infoCol.offsetHeight;
    }

    function update() {
      if (!ready || maxTranslate <= 0) return;

      var scrollY = window.pageYOffset || document.documentElement.scrollTop;
      var stickyStart = trackTop - headerH;
      var stickyEnd = stickyStart + maxTranslate;

      if (scrollY < stickyStart) {
        viewer.className = 'product-image-viewer';
        viewer.style.position = '';
        viewer.style.top = '';
        viewer.style.bottom = '';
        viewer.style.width = '';
        viewer.style.left = '';
        inner.style.transform = '';

        infoCol.style.position = '';
        infoCol.style.top = '';
        infoCol.style.width = '';
        infoCol.style.left = '';
        infoCol.style.maxHeight = '';
        infoCol.style.overflowY = '';
        infoCol.style.marginTop = '';
      } else if (scrollY <= stickyEnd) {
        viewer.className = 'product-image-viewer product-image-viewer--fixed';
        viewer.style.position = 'fixed';
        viewer.style.top = headerH + 'px';
        viewer.style.bottom = '';
        viewer.style.width = viewerWidth + 'px';
        viewer.style.left = viewerLeft + 'px';
        var progress = (scrollY - stickyStart) / maxTranslate;
        inner.style.transform = 'translate3d(0,' + -(progress * maxTranslate) + 'px,0)';

        infoCol.style.position = 'fixed';
        infoCol.style.top = headerH + 'px';
        infoCol.style.width = infoWidth + 'px';
        infoCol.style.left = infoLeft + 'px';
        infoCol.style.maxHeight = 'calc(100vh - ' + headerH + 'px)';
        infoCol.style.overflowY = 'auto';
        infoCol.style.marginTop = '';
      } else {
        viewer.className = 'product-image-viewer product-image-viewer--bottom';
        viewer.style.position = 'absolute';
        viewer.style.top = '';
        viewer.style.bottom = '0';
        viewer.style.width = '100%';
        viewer.style.left = '0';
        inner.style.transform = 'translate3d(0,' + -maxTranslate + 'px,0)';

        infoCol.style.position = '';
        infoCol.style.top = '';
        infoCol.style.width = '';
        infoCol.style.left = '';
        infoCol.style.maxHeight = '';
        infoCol.style.overflowY = '';
        infoCol.style.marginTop = Math.max(0, innerH - infoHeight) + 'px';
      }
    }

    function resetStyles() {
      viewer.className = 'product-image-viewer';
      viewer.style.cssText = '';
      inner.style.transform = '';
      track.style.height = '';
      infoCol.style.cssText = '';
      ready = false;
    }

    function init() {
      if (!desktopMq.matches) return;
      forceLoadImages();
      waitStart = Date.now();
      waitForImages();
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(function () {
          update();
          ticking = false;
        });
      }
    }

    function onResize() {
      if (!ready) return;
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function () {
        measure();
        update();
      }, 150);
    }

    desktopMq.addEventListener('change', function (e) {
      if (e.matches) {
        init();
      } else {
        resetStyles();
      }
    });

    window.addEventListener('scroll', onScroll);
    window.addEventListener('resize', onResize);

    init();
  })();

</script>
  
<style>
.variant_title {
  display: inline;
}
</style>

<script type="text/javascript">
  var _learnq = _learnq || [];

  var item = {
    Name: {{ product.title|json }},
    ProductID: {{ product.id|json }},
    Categories: {{ product.collections|map:'title'|json }},
    ImageURL: "https:{{ product.featured_image.src|img_url:'grande' }}",
    URL: "{{ shop.secure_url }}{{ product.url }}",
    Brand: {{ product.vendor|json }},
    Price: {{ product.price|money|json }},
    CompareAtPrice: {{ product.compare_at_price_max|money|json }}
  };

  _learnq.push(['track', 'Viewed Product', item]);
  _learnq.push(['trackViewedItem', {
    Title: item.Name,
    ItemId: item.ProductID,
    Categories: item.Categories,
    ImageUrl: item.ImageURL,
    Url: item.URL,
    Metadata: {
      Brand: item.Brand,
      Price: item.Price,
      CompareAtPrice: item.CompareAtPrice
    }
  }]);
</script>

