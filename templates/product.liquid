      padding-left: 10px;
      padding-right: 10px;
      max-width: none;
      margin-left: 0;
      margin-right: 0;
      box-sizing: border-box;
    }
    .product-pdp-v2 .product-pdp-heading-row {
      align-items: flex-start;
      padding: 25px 0 0 0;
      margin: 0;
      gap: 12px;
    }
