<script type="text/javascript">  
  
// Prevent form submission without user selecting a variant when size options exist
  $( "#first-form" ).submit(function( event ) {
      var $options = $('#first-form input:radio[name="id"]');
      if ($options.length === 0) {
        return;
      }
      if ($options.filter(':checked').length > 0) {
        return;
      }
      $('.product-pdp-size-label').html('PLEASE SELECT A SIZE').addClass('reminder');
      $('.product-size').addClass('no-size');
      event.preventDefault();
  });

  $(window).scroll(function() {

      if ($(window).scrollTop() > 52 ){

          $('.product-info-column2').addClass('fixed2');

    } else {

      $('.product-info-column2').removeClass('fixed2');

      };   	
  });

  $(window).scroll(function() {

      if ($(window).scrollTop() > 200 ){

          $('.product-right2').addClass('fixed2');

    } else {

      $('.product-right2').removeClass('fixed2');

      };   	
  });

  (function productImageParallax() {
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    var desktopMq = window.matchMedia('(min-width: 901px)');
    var $imgs = $('.product-page-image-column .product-parallax-img');
    if (!$imgs.length) return;

    var strength = 0.14;
    var scale = 1.06;

    function clearParallax() {
      $imgs.css('transform', '');
    }

    function updateParallax() {
      if (reduceMotion.matches || !desktopMq.matches) {
        clearParallax();
        return;
      }
      var wh = window.innerHeight || document.documentElement.clientHeight;
      var scrollY = window.pageYOffset || document.documentElement.scrollTop;
      var viewportCenter = scrollY + wh * 0.5;

      $imgs.each(function () {
        var img = this;
        var wrap = img.closest('.product-parallax-image');
        if (!wrap) return;
        var rect = wrap.getBoundingClientRect();
        var elCenter = scrollY + rect.top + rect.height * 0.5;
        var offset = (viewportCenter - elCenter) * strength;
        img.style.transform = 'translate3d(0, ' + offset + 'px, 0) scale(' + scale + ')';
      });
    }

    var ticking = false;
    function onScrollOrResize() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        updateParallax();
        ticking = false;
      });
    }

    function listenMql(mql, fn) {
      if (mql.addEventListener) mql.addEventListener('change', fn);
      else if (mql.addListener) mql.addListener(fn);
    }
    listenMql(reduceMotion, onScrollOrResize);
    listenMql(desktopMq, onScrollOrResize);

    $(window).on('scroll.productParallax resize.productParallax load', onScrollOrResize);
    $(document).on('lazyloaded', '.product-parallax-img', onScrollOrResize);
    updateParallax();
  })();

});
                             		
</script>
  
