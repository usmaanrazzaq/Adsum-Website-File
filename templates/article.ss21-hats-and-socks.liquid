{% include "loading" %}

<style>
  .article-collection-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    column-gap: 16px;
    row-gap: 20px;
    padding: 20px 40px 40px 40px;
  }
  
  .graphics-article-title {
    display: block;
    text-align: center;
    font-size: 20px;
    padding: 43px 20px 0 20px;
    width: 100%;
    max-width: 440px;
    line-height: 26px;
    margin: 0 auto;
    opacity: 1;
    -moz-transition: all .3s ease-in-out;
    -webkit-transition: all .3s ease-in-out;
    -o-transition: all .3s ease-in-out;
    -ms-transition: all .3s ease-in-out;
    transition: all .3s ease-in-out;
  }
  
  .centered-article-text {
    font-size: 12px;
  }
  
  .blog-img-caption {
    top: 10px;
  }
  
  .gallery {
    min-height: 10px;
  }
  
  .post-grid-three-column {
    display: grid; 
    grid-template-columns: repeat(3, 1fr);
    column-gap: 10px;
    row-gap: 12px;
    padding: 0px 40px 0px 40px;
  }
  .post-grid-item-1 {
    grid-column: span 1;
    display: flex;  
    align-self: center;
  }

  @media (max-width: 900px) {
    .graphics-article-title {
      font-size: 17px;
      line-height: 26px;
      text-align: left;
      padding: 80px 20px 0px;
      font-weight: 500;
      max-width: 580px;
    }  
    .article-collection-grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 16px;
      row-gap: 20px;
      padding: 20px;
    }
    .post-grid-three-column {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        padding: 0px 10px;
    }
    .post-grid-item-1 img {
      padding: 0px;
    }
  }
</style>

