<style>
  .community-header {
    font-size: 37px;
    max-width: 753px;
    line-height: 44px;
    padding-bottom: 100px;
  }
  .community-grid {
    max-width: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: min-content;
    column-gap: 20px;
    row-gap: 92px;
  }
  .community-cell {
    display: flex;
    justify-content: top;
    grid-column: span 1;
    flex-direction: column;
  }
  .community-cell .number {
    font-size: 16px;
    padding: 0 0 10px 0;
  }
  .community-cell img {
    display: block; 
    width: 100%;
  }
  .community-cell p {
    display: block;
    text-align: left;
    font-size: 14px;
    padding: 4px 0 10px 0;
    max-width: 320px;
    line-height: 19px;
    min-height: 100px;
  }
  .community-cell a {
    text-decoration: underline;
  }

  @media (max-width: 700px) {
    .community-grid {
      grid-template-columns: repeat(1, 1fr);
      grid-template-rows: min-content;
    }
    .community-header {
        font-size: 28px;
        max-width: 753px;
        line-height: 33px;
        padding-bottom: 100px;
    }
  }
  
</style>

