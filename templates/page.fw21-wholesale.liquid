<link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css" />

<script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>

<style>
  .wholesale-product-grid a:hover {
    opacity: 0.7;
    cursor: pointer;
  }
  .wholesale-title {
    display: flex; width: 100%; 
    justify-content: center; 
    align-items: center;
    font-size: 22px;
    padding: 41px 10px 39px 10px;
  }
  .swiper-container {
    width: 100%;
    height: 90vh;
    z-index: 0;
  }
  .swiper-button-prev {
    left: 40px;
  }
  
  .swiper-button-next {
    right: 40px;
  }
  
  .drop-title {
    font-size: 24px;
    padding: 10px 0px 10px;
    border-top: 1px solid #000;
  }
  
  .featured-title {
     font-size: 24px;
  }
  
  .swiper-button-next:after, .swiper-button-prev:after {
    font-family:helvetica;
    font-size: 12px;
    color: #000;
  }
  .swiper-button-next:after, .swiper-container-rtl .swiper-button-prev:after {
    content: 'Next';
  }
  .swiper-button-prev:after, .swiper-container-rtl .swiper-button-next:after {
    content: 'Prev';
  }
  .swiper-slide img {
    display: block; 
    margin: 0 auto; 
    width: auto; 
    height: 90vh;
  }
  .wholesale-product-grid {
    display: grid; 
    grid-template-columns: repeat(4, 1fr); 
    padding: 40px; 
    grid-gap: 20px;
  }
  
  .wholesale-product-title {
    line-height: 16px;
  }
  
  .wholesale-contact {
    padding: 160px 40px 120px; 
    font-size: 16px; 
    line-height: 24px;
  }
  
  .wholesale-product-highlight {
    display: grid; 
    grid-template-columns: repeat(3, 1fr);
    padding: 40px; 
  }
  
  .wholesale-product-highlight-2 {
  	display: grid; 
    grid-template-columns: repeat(2, 1fr); 
    height: 100vh; 
    overflow: hidden; 
    margin: 140px 40px;
  }
  
  .wholesale-product-highlight-text {
  	display: flex; 
    align-items: flex-end; 
    padding: 40px 0px; 
    max-width: 420px; 
    line-height: 16px;
  }
  .wholesale-product-highlight img {
    width: 100%; 
    grid-column: span 1;
  }
  .featured-product-title {
    font-size: 24px;
    padding: 100px 40px 0;
  }
  
  .drop-title span {
    display: block;
    font-size: 11px;
    padding-top: 10px;
  }
  
  .resources-grid {
  	display: grid; 
    grid-template-columns: repeat(2, 1fr); 
    padding: 40px 40px 0 40px; 
    grid-gap: 10px;
  }
  
  .resources-grid a {
    border: 1px solid #000;
    text-align: center;
    padding: 20px;
    font-size: 14px;
    background-color: #000;
    color: #fff;
  }
  
  .resources-grid a:hover {
    background-color: #fff;
    color: #000;
  }
  
  @media (max-width: 900px) {
    
    .featured-product-title {
        font-size: 18px;
        padding: 100px 20px 0;
    }
     .resources-grid {
      padding: 40px 20px 0 20px;
      line-height: 18px;
  }
    .featured-title {
      font-size: 16px;
      line-height: 24px;
    }
    .wholesale-product-highlight-2 {
      display: grid; 
      grid-template-columns: repeat(1, 1fr);  
      overflow: hidden; 
      margin: 140px 20px;
    }
    .drop-title {
    	font-size: 18px;
    }
    .wholesale-product-highlight-text {
    	grid-column: span 2;
    }
    .wholesale-product-highlight {
      display: grid; 
      grid-template-columns: repeat(4, 1fr);
      padding: 20px; 
    }
    .wholesale-product-highlight img {
      width: 100%; 
      grid-column: span 2;
    }
    .wholesale-product-highlight img:first-of-type {
      grid-column: span 4;
    }
    
    .wholesale-product-highlight-text {
        grid-column: span 3;
        padding-left: 20px;
    }
    .wholesale-product-grid {
      display: grid; 
      grid-template-columns: repeat(2, 1fr); 
      padding: 20px; 
      grid-gap: 10px;
    }
    .wholesale-title {
    	padding: 60px 20px 30px;
    }
    .wholesale-contact {
      padding: 140px 20px 110px; 
      font-size: 16px; 
      line-height: 22px;
    }
    .swiper-slide img {
      max-width: 100%;
      height: auto;
    }
    .swiper-container {
      height: auto;
    }
    .swiper-button-prev {
      left: 20px;
    }
    .swiper-button-next {
      right : 20px;
    }
      
  }
  
</style>

