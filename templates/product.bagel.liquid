<script type="text/javascript">  
  
// Prevent form submission without user selecting a size     
  $( "#first-form" ).submit(function( event ) {

      if ($('input:radio:checked').length > 0) {
        return;

      } else {

        var itemsize = $('form input[type=radio]:checked');

        $('.size-title').html('PLEASE SELECT A SIZE').addClass('reminder');     
        $('.content3').addClass('reminder').addClass("expanded");
        $('.product-size').addClass('no-size');

        event.preventDefault();
      }
  });

  $(window).scroll(function() {

      if ($(window).scrollTop() > 52 ){

          $('.product-info-column2').addClass('fixed2');

    } else {

      $('.product-info-column2').removeClass('fixed2');

      };   	
  });

  $(window).scroll(function() {

      if ($(window).scrollTop() > 200 ){

          $('.product-right2').addClass('fixed2');

    } else {

      $('.product-right2').removeClass('fixed2');

      };   	
  });

  $(document).ready(function(){
    $('.variant_title').each(function(){
    	var index = $(this).text().indexOf('/');
        var variantString = $(this).text();
        var newString = variantString.substring(index + 2, variantString.length);
        var colorString = variantString.substring(0, index);
      console.log(newString + " " + colorString);
      $(this).html(newString + "<div class='variant_color'>" + colorString + "</div>");
    });
  
    $('.sold_out').each(function(){
    	var index = $(this).text().indexOf('/');
        var variantString = $(this).text();
        var newString = variantString.substring(index + 2, variantString.length);
        var colorString = variantString.substring(0, index);
      console.log(newString + " " + colorString);
      $(this).html(newString + "<div class='variant_color'>" + colorString + "</div>");
    });
   
    
    
  });
                             		
</script>
  
<style>
.variant_title {
display: inline;
}
.variant_color {
  display: none;
}
</style>

<script type="text/javascript">
  var _learnq = _learnq || [];

  var item = {
    Name: {{ product.title|json }},
    ProductID: {{ product.id|json }},
    Categories: {{ product.collections|map:'title'|json }},
    ImageURL: "https:{{ product.featured_image.src|img_url:'grande' }}",
    URL: "{{ shop.secure_url }}{{ product.url }}",
    Brand: {{ product.vendor|json }},
    Price: {{ product.price|money|json }},
    CompareAtPrice: {{ product.compare_at_price_max|money|json }}
  };

  _learnq.push(['track', 'Viewed Product', item]);
  _learnq.push(['trackViewedItem', {
    Title: item.Name,
    ItemId: item.ProductID,
    Categories: item.Categories,
    ImageUrl: item.ImageURL,
    Url: item.URL,
    Metadata: {
      Brand: item.Brand,
      Price: item.Price,
      CompareAtPrice: item.CompareAtPrice
    }
  }]);
</script>
