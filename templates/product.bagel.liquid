{% include 'bold-product' with product, hide_action: 'break' %}{% if bold_hidden_product %}{% break %}{%endif %}

<script type="text/javascript">


  
  (function ($, F) {
    F.transitions.resizeIn = function() {
        var previous = F.previous,
            current  = F.current,
            startPos = previous.wrap.stop(true).position(),
            endPos   = $.extend({opacity : 1}, current.pos);

        startPos.width  = previous.wrap.width();
        startPos.height = previous.wrap.height();

        previous.wrap.stop(true).trigger('onReset').remove();

        delete endPos.position;

        current.inner.hide();

        current.wrap.css(startPos).animate(endPos, {
            duration : current.nextSpeed,
            easing   : current.nextEasing,
            step     : F.transitions.step,
            complete : function() {
                F._afterZoomIn();

                current.inner.fadeIn("slow");
            }
        });
    };

}(jQuery, jQuery.fancybox));

$(".fancybox")
    .attr('rel', 'gallery')
    .fancybox({
  		padding : 0 ,
        nextMethod : 'resizeIn',
        nextSpeed  : 250,
  		openSpeed : 'slow',
  		openEffect : 'fade',
  		aspectRatio : true,
		prevMethod : false,
  
  autoHeight : true,
  fitToView : false,
  maxWidth : "90%",
        
        helpers : {
			title : null  	
        }
    });


</script>


{% layout 'shop' %}

{% include "loading" %}

{% render 'breadcrumbs' %}

 
<div class="mobile-product">
  
  <h1 style="padding: 50px 20px 0; font-size: 14px; text-align:center;">{{ product.title }}</h1>
  
  <div style="padding: 4px 20px 14px 20px;; font-size: 11px; text-align:center;">
    {% if product.compare_at_price_max > product.price %}
    	<span style="text-decoration: line-through; padding-right: 10px; color: #ee5943!important;">{{ product.compare_at_price_max | money }}</span>
    {% endif %}
  	${{ product.price | money_without_currency }}
  </div>
  
  <div class="my-slider">
    <ul>
      {% for image in product.images  %}
      <li> 
          <div style="display: inline-block; width: 100%; height: 100%; vertical-align: middle;">
          	<a class="fancybox crosshair" href="{{ image | product_img_url: 'master' }}" rel="images" title="{{ product.title | strip_html | escape }}">
              <img src="{{ image | product_img_url: '100x100' }}" data-src="{{ image | product_img_url: 'master' }}" alt="{{ product.title | escape }}" class="mobile-product-images lazyload" />
          	</a>
          </div>
      </li>
      {% endfor %}
    </ul>
  </div>
  
</div>
         

<div class="product-page-table">
<div class="product-page-image-column mobile-hide">
<div class="product-page-image-column-mobile">
    {% for tag in product.tags %}
    {% if tag == 'show-image' %}
    {% if settings.show_product_show_image %}
    <a class="fancybox" href="{{ image | product_img_url: 'master' }}" title="{{ product.title | strip_html | escape }}"><img src="{{ 'product_show_image.png' | asset_url }}" class="product-hover-image" style="display: block; margin: 0 auto;" alt="{{ product.title | strip_html | escape }}"/></a>
    {% endif %}
    {% endif %}
    {% endfor %}
  
  {% if product.images.size > 1 %}
  
  {% for image in product.images  %}
  <div class="image">
    <a class="fancybox crosshair" href="{{ image | product_img_url: 'master' }}" rel="images" title="{{ product.title | strip_html | escape }}">
      <img src="{{ image | product_img_url: '100x100' }}" data-src="{{ image | product_img_url: 'master' }}" alt="{{ product.title | escape }}" class="product-thumb {% cycle 'first', '', '', 'last' %} lazyload" style="display: block; margin: 0 auto;"/>
    </a>
  </div>
  {% endfor %}
  
  {% endif %}
</div>
</div>
          

  
<div class="product-info-column">
  <h1 class="product-title2 mobile-hide">{{ product.title }}</h1>

  <div class="product-description mobile-hide">
    <div id="product-description" class="description">
      {{ product.description }}
    </div>
  </div>

  <div style="float:left; width:100%;">
    <div id="product-price" class="price mobile-hide">
      <div class="product-info-title">
        Price:
      </div>
      <div class="product-info-variable2">
        	{% if product.compare_at_price_max > product.price %}
            <span style="text-decoration: line-through; padding-right: 10px; color: #ee5943!important;">{{ product.compare_at_price_max | money }}</span>
            {% endif %}
        {{ product.price | money }}
      </div>
      <div style="clear: both;"></div>
    </div>
  </div>

  <div style="width:100%">
        <div id="purchase-wrapper">
          	<a href="https://www.google.com/maps/dir//Leo,+123+Havemeyer+St,+Brooklyn,+NY+11211/@40.7125596,-73.9567886,15z/data=!4m16!1m6!3m5!1s0x0:0xffeefd33565822d9!2sLeo!8m2!3d40.7125596!4d-73.9567886!4m8!1m0!1m5!1m1!1s0x89c259f246a16dc1:0xffeefd33565822d9!2m2!1d-73.9567886!2d40.7125596!3e3" target="_blank" class="addtocart2" style="text-align: center;" />Get Directions</a>
        </div>
      </div>
    
    <div id="product-description" class="description desktop-hide">
      {{ product.description }}
    </div>
    
    <a href="#" class="product-info-link" data-featherlight="#fl_product_shipping" data-featherlight-variant="product_readmore">
      Shipping/Returns
    </a>
    
    
  </div>
</div>
</div>


