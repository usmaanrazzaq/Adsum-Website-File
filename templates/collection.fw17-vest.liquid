{% include "loading" %}

{% paginate collection.products by 30 %}

<h1 class="collection-title">{{ collection.title }}</h1>


{% if settings.collection_pagination %}
<small>Showing items {{ paginate.current_offset | plus: 1 }}-{% if paginate.next %}{{ paginate.current_offset | plus: paginate.page_size }}{% else %}{{ paginate.items }}{% endif %} of {{ paginate.items }}.</small>
{% endif %}

<div id="adsumspace">
  
  <div class="fw17-coaches-padding" style="position:relative;">
    <img src="https://cdn.shopify.com/s/files/1/0664/2387/files/adsum-coaches-collection-vest.jpg?9586775040334178689" class="coaches-jacket-img">
    <img src="https://cdn.shopify.com/s/files/1/0664/2387/files/adsum-coaches-collection-mobile.jpg?10782663228393854391" class="coaches-jacket-img-mobile" style="">
  </div>
  
<div id="products" class="gallery">
{% if collection.products.size == 0 %}
	<p>There are currently no products in this collection. Please check back later.</p>
{% else %}
	{% include "gallery" %}
{% endif %}
</div>

<div class="fw17-coaches-padding">
  <a href="/collections/fw17" class="fw17-coaches-link">
    See Full FW17 Collection
  </a>
</div>

{% if paginate.pages > 1 %}
	<div id="paginate">
		{{ paginate | default_pagination }}
	</div>
{% endif %}

{% endpaginate %}

</div>

<div style="padding: 100px 0 0 0;"></div>
{% include "footer" %}