{% include "loading" %}

<style>
  .page-grid-1 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 0px;
    row-gap: 0px;
    padding: 100px 40px 40px 40px;
    max-width: 1400px;
    margin: 0 auto;
  }
  .page-grid-item {
    grid-column: span 1;
    display: flex;  
    flex-direction: column; 
    align-self: top;
  }
  img { 
    display: block; 
    width:100%; 
    height: auto;
  }
  .centered-img img {
    max-width: 700px; 
    margin: 0 auto;
    padding: 100px 0 40px;
  }
  .caption {
    padding-top: 6px;
    font-size: 10px;
    line-height: 14px;
    color: #666;
  } 
  .centered-article-text {
    font-size: 12px;
    width: 600px;
    margin: 0 auto;
    line-height: 150%;
  }
  .graphics-article-title {
    display: block;
    text-align: center;
    font-size: 20px;
    padding: 43px 20px 0 20px;
    width: 100%;
    max-width: 440px;
    line-height: 26px;
    margin: 0 auto;
    opacity: 1;
    -moz-transition: all .3s ease-in-out;
    -webkit-transition: all .3s ease-in-out;
    -o-transition: all .3s ease-in-out;
    -ms-transition: all .3s ease-in-out;
    transition: all .3s ease-in-out;
  }
  .cover-image {
    display: block;
    width: auto;
    height: auto;
    max-width: 1200px;
    margin: 100px auto;
  }  
  .lookbook-shop-button {
    border: 1px solid #000;
    background-color: #fff;
    color: #000;
    max-width: 500px;
    display: block;
    margin: 0 auto;
    font-size: 14px;
    text-align: center;
    padding: 10px 10px;
    margin-bottom: 160px;
  }
  .lookbook-shop-button:active, .lookbook-shop-button:hover {
    background-color: #000;
    color: #fff;
    border: 1px solid #000;
  }
  .article-collection-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    column-gap: 16px;
    row-gap: 20px;
    padding: 20px 40px 40px 40px;
    max-width: 1800px;
    margin: 0 auto;
  }
  
  .article-product-desc a {
    font-weight: 600;
  }
  
  .article-product-desc a::before {
    content: "→ ";
    font-weight: 600;
  }
  
  .article-product-desc a:hover {
    color: #ccc;
  }
  
/************************ SPECEFIC *****************************************/
  
.alec-title-1 {  
  position: absolute; 
  top: 60px; 
  width: 100%; 
  text-align: center; 
  color: #fff; 
  font-size: 40px;
}
  
.alec-title-2 {  
  position: absolute; 
  bottom: 60px; 
  width: 100%; 
  text-align: center; 
  color: #fff; 
  font-size: 17px;
}
.article-product-desc {
  font-size: 13px; 
  line-height: 19px; 
  padding-top: 20px; 
  max-width: 440px;
}
 
/************************ MEDIA QUERIES ************************************/
  
  @media (max-width: 900px) {
    .page-grid-1 {
      grid-template-columns: repeat(2, 1fr);
      padding: 80px 10px 0px;
      row-gap: 10px;
    }
    .page-grid-item {
      grid-column: span 2;
    }
    .centered-article-text {
    	width: 100%;
    }
    .new-centered-article-text {
      padding-top: 140px!important;
    }
    .graphics-article-title {
      font-size: 18px;
      line-height: 26px;
      top: 67px;
      padding-top: 80px;
    }
    .cover-image {
      width: 100%;
    }
    .article-collection-grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 16px;
      row-gap: 20px;
      padding: 20px;
    }
    
    .alec-title-1 {  
      top: 20px;
      font-size: 24px;
      padding: 0 20px;
    }
    .alec-title-2 {  
      font-size: 14px;
      padding: 0 20px;
      bottom: 20px;
    }
    .article-product-desc {
      font-size: 12px;
      line-height: 18px;
      padding-top: 20px;
      max-width: 300px;
      grid-column: span 2;
    }
  }
  
  @media (max-width: 400px) {
    
  }
</style>

