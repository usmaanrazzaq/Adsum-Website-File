<script>
  function startTime() {
  offset = 20;
  var today = new Date();
  var h = today.getUTCHours();
  var m = today.getUTCMinutes();
  var s = today.getUTCSeconds();
  h = h + offset;
  if (h > 24) {
    h = h - 24;
  }
  if (h < 0) {
    h = h + 24;
  }
  h = checkTime(h);
  m = checkTime(m);
  s = checkTime(s);
  document.getElementById('clock').innerHTML = h + ":" + m + ":" + s;
  var t = setTimeout(function() {
    startTime()
  }, 500);
}

function checkTime(i) {
  if (i < 10) {
    i = "0" + i
  };
  return i;
}

startTime()
</script>

    <script>
  function toggleCollection(button, id) {
    const grid = document.getElementById(id);
    if (!grid) return;

    grid.classList.toggle('expanded');
    const showingAll = grid.classList.contains('expanded');
    button.textContent = showingAll ? 'Show Less' : 'Show More';
  }
</script>

