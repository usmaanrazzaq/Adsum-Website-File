    display: grid;
    column-gap: 10px;
    padding-bottom: 80px;
  }
  .three-across img{
    grid-column: span 2;
    width: 100%;
    margin-block: 10px;
  }
    .three-across a{
    grid-column: span 2;
    width: 100%;
    margin-block: 10px;
  }
  .one-across img{
    grid-column: span 4;
    height: 50vh;
    width: 100%;
    object-fit: cover;
  }

    @media (max-width: 900px) {
      .hero-title{
        font-size: 36px;
        font-weight: normal;
        margin-top: 20px;
        margin-bottom: 15px;
      }
      .hero-text{
        grid-column: 1 / span 12;
        font-size: 12px;
      }
      .hero-image{
          grid-column: 1 / span 12;
          grid-row: 1;
      }
      .hero-button{
        grid-column: 1 / span 4;
        position: inherit;
      }
      .grid-container{
        grid-template-columns: repeat(12, 1fr);
        column-gap: 0px;
        grid-row-gap: 0px;
        display: grid;
        margin: 50px 10px 0 10px; 
      }
      .section-images{
        grid-column: 1 / span 12;
        padding-bottom: 40px;
      }
      .section-header{
        position: initial;
        padding-bottom: 0px;
      }
      .section-header{
        position: initial;
        padding-bottom: 10px;
      }
      .section-bullet{
        position: static;
        height: 100%;
      }
      .hero-button-overview {
        position: initial;
      }
      .one-across img{
        grid-column: span 6;
        height: 25vh;
        width: 100%;
        object-fit: cover;
      }
        .three-across img{
        grid-column: span 3;
        width: 100%;
        margin-top: 0px;
      }
    }   
    @media (max-width: 400px) { 
    }
</style>

