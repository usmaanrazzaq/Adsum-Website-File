{% comment %}
  Site Promo Banner + GWP Auto-Add
  Always-visible promo banner for: Free Classic Logo Hat - Stone with $200+ purchase.
  Rendered globally via menu.liquid: {% render 'gwp-cart-banner' %}

  Visual styling lives in assets/styles.css.liquid under `.site-promo-banner`.

  Requires the "Free Classic Logo Hat - Stone — Spend $200+" automatic
  Buy X Get Y discount in Shopify — that is what makes the added hat $0.
  This snippet only auto-ADDS the hat (Shopify's BXGY discount cannot do that)
  and auto-removes it if the cart drops back below the threshold.
  The hat is added with line item property _gwp:true so it can be identified.
{% endcomment %}

<div class="site-promo-banner" role="region" aria-live="polite" aria-label="Promotion">
  <p id="gwp-banner-msg">Spend $200 and get a free Classic Logo Hat - Stone added automatically to your order</p>
</div>

<script>
(function() {
  var THRESHOLD   = 20000;          // $200.00 in cents
  var GWP_VARIANT = 39669979414646; // Classic Logo Hat - Stone / OS
  var DEFAULT_MSG = 'Spend $200 and get a free Classic Logo Hat - Stone added automatically to your order';

  var _busy = false;

  function formatMoney(cents) {
    return '$' + (cents / 100).toFixed(2).replace(/\.00$/, '');
  }

  // Line key of the auto-added hat (the one carrying the _gwp property).
  function gwpLineKey(cart) {
    for (var i = 0; i < cart.items.length; i++) {
      var it = cart.items[i];
      if (it.variant_id === GWP_VARIANT && it.properties && it.properties._gwp === 'true') return it.key;
    }
    return null;
  }

  // Is the hat in the cart at all — auto-added OR manually added by the customer.
  function hatIsInCart(cart) {
    for (var i = 0; i < cart.items.length; i++) {
      if (cart.items[i].variant_id === GWP_VARIANT) return true;
    }
    return false;
  }

  // Cart total used to evaluate the threshold — excludes the auto-added hat line.
  function qualifyingTotal(cart) {
    var total = 0;
    for (var i = 0; i < cart.items.length; i++) {
      var it = cart.items[i];
      if (it.variant_id === GWP_VARIANT && it.properties && it.properties._gwp === 'true') continue;
      total += it.final_line_price;
    }
    return total;
  }

  function setMsg(text) {
    var msg = document.getElementById('gwp-banner-msg');
    if (msg) msg.textContent = text;
  }

  function renderBanner(cart, opts) {
    opts = opts || {};
    var total = qualifyingTotal(cart);

    if (opts.outOfStock) {
      setMsg('You’ve qualified for a free Classic Logo Hat - Stone, but it’s currently out of stock.');
    } else if (total >= THRESHOLD) {
      setMsg('You’ve unlocked a free Classic Logo Hat - Stone — added to your order automatically.');
    } else if (total > 0) {
      setMsg('Spend ' + formatMoney(THRESHOLD - total) + ' more to get a free Classic Logo Hat - Stone added to your order.');
    } else {
      setMsg(DEFAULT_MSG);
    }
  }

  function addGwp() {
    return fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: GWP_VARIANT, quantity: 1, properties: { '_gwp': 'true' } })
    }).then(function(r) {
      if (!r.ok) throw new Error('add failed');
      return r.json();
    });
  }

  function removeGwp(lineKey) {
    return fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: lineKey, quantity: 0 })
    }).then(function(r) { return r.json(); });
  }

  function refetchCart() {
    return fetch('/cart.js').then(function(r) { return r.json(); });
  }

  function isCartPage() {
    return /\/cart$/.test(window.location.pathname.replace(/\/+$/, ''));
  }

  // Reflect the new item count in the header without a full reload.
  function updateCartCount(count) {
    var els = document.querySelectorAll('.cart-count, #eyebrow-cart, .item-count');
    for (var i = 0; i < els.length; i++) {
      var html = els[i].innerHTML;
      if (/[0-9]+/.test(html)) els[i].innerHTML = html.replace(/[0-9]+/, count);
    }
  }

  // The /cart page is server-rendered, so it must reload to show the hat.
  // Anywhere else, just refresh the header count.
  function afterCartChange(cart) {
    document.dispatchEvent(new CustomEvent('cart:refresh'));
    if (isCartPage()) {
      window.location.reload();
      return;
    }
    updateCartCount(cart.item_count);
  }

  function syncGwp(cart) {
    if (_busy) return;

    var total  = qualifyingTotal(cart);
    var gwpKey = gwpLineKey(cart);

    // Qualifies and the hat has not been auto-added yet.
    if (total >= THRESHOLD && !gwpKey) {
      // Customer already added the hat themselves — don't add a duplicate.
      if (hatIsInCart(cart)) { renderBanner(cart); return; }

      _busy = true;
      addGwp()
        .then(refetchCart)
        .then(function(updated) {
          renderBanner(updated);
          _busy = false;
          afterCartChange(updated);
        })
        .catch(function() {
          // Add failed — most likely the hat is out of stock.
          _busy = false;
          renderBanner(cart, { outOfStock: true });
        });
      return;
    }

    // Dropped below the threshold but the auto-added hat is still in the cart.
    if (total < THRESHOLD && gwpKey) {
      _busy = true;
      removeGwp(gwpKey)
        .then(refetchCart)
        .then(function(updated) {
          renderBanner(updated);
          _busy = false;
          afterCartChange(updated);
        })
        .catch(function() { _busy = false; });
      return;
    }

    renderBanner(cart);
  }

  function fetchAndSync() {
    refetchCart().then(syncGwp).catch(function() {});
  }

  document.addEventListener('DOMContentLoaded', fetchAndSync);

  // Re-sync after any cart mutation (covers jQuery/XHR and fetch-based carts).
  var CART_RE = /\/cart\/(add|change|update|clear)/;

  var _origOpen = XMLHttpRequest.prototype.open;
  XMLHttpRequest.prototype.open = function(method, url) {
    if (typeof url === 'string' && CART_RE.test(url)) {
      this.addEventListener('load', function() { setTimeout(fetchAndSync, 500); });
    }
    return _origOpen.apply(this, arguments);
  };

  var _origFetch = window.fetch;
  window.fetch = function(input, init) {
    var url = typeof input === 'string' ? input : (input && input.url) || '';
    var result = _origFetch.apply(this, arguments);
    if (typeof url === 'string' && CART_RE.test(url)) {
      result.then(function() { setTimeout(fetchAndSync, 500); }).catch(function() {});
    }
    return result;
  };
})();
</script>
