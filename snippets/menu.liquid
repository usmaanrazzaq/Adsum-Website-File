        <path d="M17 17L21 21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    {%- comment -%}
      Always rendered, even on an empty cart, so the control stays tappable and the
      dropdown has an anchor. Previously this whole block was omitted at zero.
    {%- endcomment -%}
    <button type="button" class="mobile-cart" aria-controls="cart-dropdown" aria-expanded="false" aria-label="Cart">
      <svg class="nav-icon mobile-nav-icon mobile-cart-bag" width="18" height="18" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" aria-hidden="true" focusable="false">
