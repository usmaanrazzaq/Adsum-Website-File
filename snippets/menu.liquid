<header class="header-mobile">
  <button type="button" class="hamburger hamburger--squeeze toggle" aria-label="Menu" aria-controls="mobile-menu" aria-expanded="false">
    <span class="hamburger-box">
      <span class="hamburger-inner"></span>
    </span>
  </button>

  <div class="mobile-logo-block">
    <a href="/" title="Adsum">
      <img src="https://cdn.shopify.com/s/files/1/0664/2387/files/adsum-logotype.svg?2454093459023626839" class="mobile-logo-image" alt="Adsum" width="82" height="20">
    </a>
  </div>

  <div class="mobile-nav-actions">
    <button type="button" class="mobile-search" aria-controls="search-dropdown" aria-expanded="false" aria-label="Search">
      <svg class="nav-icon mobile-nav-icon" width="18" height="18" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" aria-hidden="true" focusable="false">
