<script>
/**
 * Module to ajaxify all add to cart forms on the page.
 *
 * Copyright (c) 2015 Caroline Schnapp (11heavens.com)
 * Dual licensed under the MIT and GPL licenses:
 * http://www.opensource.org/licenses/mit-license.php
 * http://www.gnu.org/licenses/gpl.html
 *
 */
Shopify.AjaxifyCart = (function($) {
  
  // Some configuration options.
  // I have separated what you will never need to change from what
  // you might change.
  
  var _config = {

    // What you might want to change
    addingToCartBtnLabel:          'ADDING...',
    soldOutBtnLabel:               'SOLD OUT',
    cartCountSelector:             '.cart-count, #cart-count a:first, #gocart p a, #cart .checkout em, .item-count',
    cartTotalSelector:             '#cart-price',
    // 'aboveForm' for top of add to cart form, 
    // 'belowForm' for below the add to cart form, and 
    // 'nextButton' for next to add to cart button.
    feedbackPosition:              'nextButton',
    
    // What you will never need to change
    addToCartBtnSelector:          '[type="submit"]',
    addToCartFormSelector:         'form[action*="/cart/add"]',
    shopifyAjaxAddURL:             '/cart/add.js',
    shopifyAjaxCartURL:            '/cart.js'
  };
  
  // We need some feedback when adding an item to the cart.
  // Here it is.  
  var _showFeedback = function(success, html, $addToCartForm) {
    $('.ajaxified-cart-feedback').remove();
    var feedback = '<p class="ajaxified-cart-feedback ' + success + '">' + html + '</p>';
    switch (_config.feedbackPosition) {
      case 'aboveForm':
        $addToCartForm.before(feedback);
        break;
      case 'belowForm':
        $addToCartForm.after(feedback);
        break;
      case 'nextButton':
      default:
        $addToCartForm.find(_config.addToCartBtnSelector).after(feedback);
        break;   
    }
    // If you use animate.css
    // $('.ajaxified-cart-feedback').addClass('animated bounceInDown');
    $('.ajaxified-cart-feedback').slideDown();
  };
  var _setText = function($button, label) {
    if ($button.children().length) {
      $button.children().each(function() {
        if ($.trim($(this).text()) !== '') {
          $(this).text(label);
        }
      });
    }
    else {
      $button.val(label).text(label);
    }
  };
  // Remember each button's own label instead of forcing a configured one back.
  // The old code reset every button to 'ADD TO BAG', which silently rewrote the
  // PDP's "Add to cart" a second after each add.
  var _restoreLabel = function($button) {
    var original = $button.data('ajaxifyOriginalLabel');
    if (original !== undefined) _setText($button, original);
  };
  var _rememberLabel = function($button) {
    if ($button.data('ajaxifyOriginalLabel') === undefined) {
      var label = $button.children().length ? $.trim($button.children().first().text()) : $button.val();
      $button.data('ajaxifyOriginalLabel', label);
    }
  };
  // Hand off to the cart dropdown when it is present. It is not on layouts that
  // include this snippet without menu.liquid (e.g. theme.no-shopping.liquid).
  var _dropdown = function() {
    return window.AdsumCart || null;
  };
  var _showVariantSelectionError = function($addToCartForm) {
    var $sizeTitle = $addToCartForm.prevAll('.size-title').first();
    var $pdpSizeTitle = $addToCartForm.prevAll('.product-pdp-size-label').first();
    var $productSize = $addToCartForm.find('.product-size').first();
    var message = 'PLEASE SELECT A SIZE';

    if ($sizeTitle.text().toLowerCase().indexOf('amount') !== -1) {
      message = 'PLEASE SELECT AN AMOUNT';
    }

    if ($pdpSizeTitle.length) {
      $pdpSizeTitle.html(message).addClass('reminder');
    }
    if ($sizeTitle.length) {
      $sizeTitle.html(message).addClass('reminder');
    }

    if ($productSize.length) {
      $productSize
        .addClass('no-size')
        .find('.variant-selection-feedback')
        .remove()
        .end()
        .append('<p class="variant-selection-feedback">Select one of these options</p>');
    }
    $('.content3').addClass('reminder').addClass('expanded');
  };
  var _hasSelectedVariant = function($addToCartForm) {
    var $variantRadios = $addToCartForm.find('input:radio[name="id"]');

    if ($variantRadios.length) {
      return $variantRadios.filter(':checked').length > 0;
    }

    return !!$addToCartForm.find('[name="id"]').val();
  };
  var _bindVariantSubmitGuard = function() {
    document.addEventListener('submit', function(event) {
      var form = event.target;

      if (!form || !form.action || form.action.indexOf('/cart/add') === -1) {
        return;
      }

      var $addToCartForm = $(form);
      if (_hasSelectedVariant($addToCartForm)) {
        return;
      }

      event.preventDefault();
      event.stopImmediatePropagation();
      _showVariantSelectionError($addToCartForm);
    }, true);
  };
  var _init = function() {   
    $(document).ready(function() { 
      _bindVariantSubmitGuard();
      $(_config.addToCartFormSelector).submit(function(e) {
        e.preventDefault();
        var $addToCartForm = $(this);
        var $addToCartBtn = $addToCartForm.find(_config.addToCartBtnSelector);
        _rememberLabel($addToCartBtn);

        if (!_hasSelectedVariant($addToCartForm)) {
          _showVariantSelectionError($addToCartForm);
          return false;
        }

        _setText($addToCartBtn, _config.addingToCartBtnLabel);
        $addToCartBtn.addClass('disabled').prop('disabled', true);
        // Add to cart.
        $.ajax({
          url: _config.shopifyAjaxAddURL,
          dataType: 'json',
          type: 'post',
          data: $addToCartForm.serialize(),
          success: function(itemData) {
            // Re-enable add to cart button immediately — the confirmation now
            // lives in the cart dropdown, not in the button's label.
            $addToCartBtn.prop('disabled', false).removeClass('disabled');
            _restoreLabel($addToCartBtn);
            $('.ajaxified-cart-feedback').remove();

            var dropdown = _dropdown();
            if (dropdown) {
              dropdown.showError(null);
              dropdown.refresh().then(dropdown.open).catch(function() {});
              return;
            }

            // No dropdown on this layout — keep the old inline confirmation.
            _showFeedback('success','<strong>ADDED TO CART</strong>. Please <a href="/cart" style="color: #3D9970;">view cart</a> or <a href="javascript:history.go(-1)" title="continue shopping" style="color: #3D9970;">continue shopping</a>.',$addToCartForm);
            // Update cart count and show cart link.
            $.getJSON(_config.shopifyAjaxCartURL, function(cart) {
              if (_config.cartCountSelector && $(_config.cartCountSelector).size()) {
                var value = $(_config.cartCountSelector).html() || '0';
                $(_config.cartCountSelector).html(value.replace(/[0-9]+/,cart.item_count)).removeClass('hidden-count');
              }
              if (_config.cartTotalSelector && $(_config.cartTotalSelector).size()) {
                if (typeof Currency !== 'undefined' && typeof Currency.moneyFormats !== 'undefined') {
                  var newCurrency = '';
                  if ($('[name="currencies"]').size()) {
                    newCurrency = $('[name="currencies"]').val();
                  }
                  else if ($('#currencies span.selected').size()) {
                    newCurrency = $('#currencies span.selected').attr('data-currency');
                  }
                  if (newCurrency) {
                    $(_config.cartTotalSelector).html('<span class=money>' + Shopify.formatMoney(Currency.convert(cart.total_price, "{{ shop.currency }}", newCurrency), Currency.money_format[newCurrency]) + '</span>');
                  } 
                  else {
                    $(_config.cartTotalSelector).html(Shopify.formatMoney(cart.total_price, "{{ shop.money_format | remove: "'" | remove: '"' }}"));
                  }
                }
                else {
                  $(_config.cartTotalSelector).html(Shopify.formatMoney(cart.total_price, "{{ shop.money_format | remove: "'" | remove: '"' }}"));
                }
              };
            });        
          }, 
          error: function(XMLHttpRequest) {
            var response;
            try {
              response = JSON.parse(XMLHttpRequest.responseText).description;
            } catch (e) {}
            if (!response) response = 'Sorry — we could not add that to your cart. Please try again.';

            var soldOut = response.slice(0,4) === 'All ';
            var message = soldOut ? response.replace('All 1 ', 'All ') : response;

            if (soldOut) {
              _setText($addToCartBtn, _config.soldOutBtnLabel);
              $addToCartBtn.prop('disabled', true);
            }
            else {
              $addToCartBtn.prop('disabled', false).removeClass('disabled');
              _restoreLabel($addToCartBtn);
            }

            // Surface the failure. It used to be injected into an element that
            // assets/styles.css.liquid hid with `display: none !important`, so
            // add-to-cart errors were invisible to the customer.
            var dropdown = _dropdown();
            if (dropdown) {
              dropdown.showError(message);
              dropdown.refresh().then(dropdown.open).catch(function() { dropdown.open(); });
              return;
            }
            _showFeedback('error', message, $addToCartForm);
          }
        });   
        return false;    
      });
    });
  };
  return {
    init: function(params) {
        // Configuration
        params = params || {};
        // Merging with defaults.
        $.extend(_config, params);
        // Action
        $(function() {
          _init();
        });
    },    
    getConfig: function() {
      return _config;
    }
  }  
})(jQuery);
Shopify.AjaxifyCart.init();
</script>


<style>
.ajaxified-cart-feedback {
    display: block;
    line-height: 17px;
    font-size: 12px;
    vertical-align: top;
    padding-bottom: 10px;
}
.ajaxified-cart-feedback.success { 
  color: #3D9970;
}
/* Previously `display: none !important`, which meant add-to-cart failures
   (sold out, inventory limits) were never shown to the customer. Errors now go
   to the cart dropdown where it exists; this is the fallback for layouts
   without it. */
.ajaxified-cart-feedback.error {
  color: #FF4136;
}
.ajaxified-cart-feedback a {
  border-bottom: 1px solid;
}
.variant-selection-feedback {
  display: block;
  clear: both;
  color: #FF4136;
  font-size: 12px;
  line-height: 16px;
  margin: 8px 0 0;
}
</style>
