{% comment %}
  Cart Dropdown (mini-cart)

  Replaces the old "redirect to /cart" add-to-cart flow. The panel drops from the
  header on add-to-cart, and toggles open when the customer clicks Cart.

  Rendered globally from the end of snippets/menu.liquid.

  Driven by snippets/ajaxify-cart.liquid (which intercepts every
  form[action="/cart/add"]) through the window.AdsumCart API below.

  Visual styling lives in assets/styles.css.liquid under `.cart-dropdown`.
{% endcomment %}

<div class="cart-dropdown" id="cart-dropdown" role="dialog" aria-modal="false" aria-label="Cart" tabindex="-1" hidden>
  <p class="cart-dropdown__error" id="cart-dropdown-error" hidden></p>
  <div class="cart-dropdown__items" id="cart-dropdown-items"></div>
  <div class="cart-dropdown__foot" id="cart-dropdown-foot"></div>
</div>

<script>
(function() {
  var panel = document.getElementById('cart-dropdown');
  if (!panel) return;

  var itemsEl = document.getElementById('cart-dropdown-items');
  var footEl  = document.getElementById('cart-dropdown-foot');
  var errEl   = document.getElementById('cart-dropdown-error');

  var MONEY        = "{{ shop.money_format | remove: "'" | remove: '"' }}";
  var MONEY_WITH_C = "{{ shop.money_with_currency_format | remove: "'" | remove: '"' }}";

  var isOpen  = false;
  var busy    = false;
  var rafId   = null;

  /* ---------- helpers ---------- */

  function esc(str) {
    return String(str == null ? '' : str)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function isMobile() {
    return window.matchMedia('(max-width: 900px)').matches;
  }

  // Mirrors the theme's existing use of Shopify.formatMoney in ajaxify-cart,
  // with a self-contained fallback so the panel never renders a raw cent value.
  function money(cents, withCurrency) {
    var format = withCurrency ? MONEY_WITH_C : MONEY;
    if (window.Shopify && typeof Shopify.formatMoney === 'function') {
      try { return Shopify.formatMoney(cents, format); } catch (e) {}
    }
    var amount = (cents / 100).toFixed(2);
    if (/\{\{\s*amount_no_decimals/.test(format)) amount = String(Math.round(cents / 100));
    return format.replace(/\{\{\s*[a-z_]+\s*\}\}/, amount);
  }

  // Ask the CDN for a smaller file than the full-size product shot.
  function sizedImage(url, size) {
    if (!url) return '';
    var parts = url.split('?');
    var query = parts[1] ? '?' + parts[1] : '';
    return parts[0].replace(/(\.(png|jpe?g|gif|webp))$/i, '_' + size + '$1') + query;
  }

  function isGwp(item) {
    return !!(item.properties && item.properties._gwp === 'true');
  }

  function anchorEl() {
    return isMobile()
      ? document.querySelector('.header-mobile')
      : document.getElementById('eyebrow-cart');
  }

  function toggleEls() {
    var els = [];
    var eyebrow = document.getElementById('eyebrow-cart');
    var mobile  = document.querySelector('.mobile-cart');
    if (eyebrow) els.push(eyebrow);
    if (mobile) els.push(mobile);
    return els;
  }

  /* ---------- positioning ---------- */

  // One fixed-position panel for both breakpoints. `top` is read off the anchor
  // each time so the panel tracks the promo banner and the sticky mobile header
  // instead of assuming a fixed header height.
  function position() {
    var anchor = anchorEl();
    if (!anchor) return;

    var r = anchor.getBoundingClientRect();

    if (isMobile()) {
      panel.style.top   = Math.max(0, r.bottom) + 'px';
      panel.style.left  = '0px';
      panel.style.right = '0px';
    } else {
      // Clamp to the viewport: on desktop the nav is not sticky, so the anchor
      // is usually scrolled off-screen by the time the customer reaches the
      // add-to-cart button on a PDP.
      panel.style.top   = Math.max(10, r.bottom + 8) + 'px';
      panel.style.left  = 'auto';
      panel.style.right = Math.max(10, document.documentElement.clientWidth - r.right) + 'px';
    }
  }

  // Cancel-and-reschedule rather than bailing out when a frame is already
  // pending: a bail-out guard leaves rafId set forever if that frame never
  // runs (backgrounded tab), which would silently freeze the panel in place.
  function schedulePosition() {
    if (rafId) window.cancelAnimationFrame(rafId);
    rafId = window.requestAnimationFrame(function() {
      rafId = null;
      if (isOpen) position();
    });
  }

  /* ---------- rendering ---------- */

  // Bold Quantity Breaks (shappify_qb) creates hidden per-tier variants that
  // share product + options but have different variant_ids. Match on product
  // + options so outerwear tiers collapse back into one row.
  function optionsSignature(item) {
    var ov = item.options_with_values || [];
    var parts = [];
    for (var i = 0; i < ov.length; i++) {
      if (!ov[i].value || ov[i].value === 'Default Title') continue;
      parts.push(String(ov[i].name) + ':' + String(ov[i].value));
    }
    return parts.join('|');
  }

  function renderItem(item, line) {
    var img = sizedImage(item.image || (item.featured_image && item.featured_image.url), '300x');
    var key = item.key || '';
    var optSig = optionsSignature(item);

    var options = '';
    var ov = item.options_with_values || [];
    for (var i = 0; i < ov.length; i++) {
      if (!ov[i].value || ov[i].value === 'Default Title') continue;
      options += '<div class="cart-dropdown__meta">' + esc(ov[i].name) + ': ' + esc(ov[i].value) + '</div>';
    }

    // The GWP hat is re-added automatically by gwp-cart-banner ~500ms after any
    // cart change, so editing its quantity here would silently bounce back.
    var qtyRow = isGwp(item)
      ? '<div class="cart-dropdown__meta">Quantity: ' + item.quantity + ' &middot; Gift</div>'
      : '<div class="cart-dropdown__qty">' +
          '<span class="cart-dropdown__meta">Quantity: ' + item.quantity + '</span>' +
          '<span class="cart-dropdown__steppers">' +
            stepper('minus', item, line, item.quantity - 1, 'Decrease quantity of ' + item.title) +
            stepper('plus',  item, line, item.quantity + 1, 'Increase quantity of ' + item.title) +
          '</span>' +
        '</div>';

    return '' +
      '<div class="cart-dropdown__item" data-line="' + line + '" data-key="' + esc(key) + '"' +
        ' data-variant="' + item.variant_id + '" data-product="' + item.product_id + '"' +
        ' data-options="' + esc(optSig) + '">' +
        (img
          ? '<div class="cart-dropdown__thumb" style="background-image:url(' + esc(img) + ')" role="img" aria-label="' + esc(item.title) + '"></div>'
          : '<div class="cart-dropdown__thumb cart-dropdown__thumb--empty"></div>') +
        '<div class="cart-dropdown__info">' +
          '<div class="cart-dropdown__title">' + esc(item.product_title || item.title) + '</div>' +
          options +
          qtyRow +
          '<div class="cart-dropdown__price">Price: ' + money(item.final_line_price, true) + '</div>' +
        '</div>' +
      '</div>';
  }

  function stepper(kind, item, line, toQty, label) {
    var path = kind === 'minus'
      ? '<path d="M10.2 17.85C14.426 17.85 17.85 14.426 17.85 10.2 17.85 5.974 14.426 2.55 10.2 2.55 5.974 2.55 2.55 5.974 2.55 10.2 2.55 14.426 5.974 17.85 10.2 17.85Z"/>' +
        '<path d="M13.6 10.2H6.8"/>'
      : '<path d="M10.2 6.8V13.6"/>' +
        '<path d="M13.6 10.2H6.8"/>' +
        '<path d="M10.2 17.85C14.426 17.85 17.85 14.426 17.85 10.2 17.85 5.974 14.426 2.55 10.2 2.55 5.974 2.55 2.55 5.974 2.55 10.2 2.55 14.426 5.974 17.85 10.2 17.85Z"/>';

    return '<button type="button" class="cart-dropdown__stepper" data-key="' + esc(item.key || '') + '"' +
      ' data-line="' + line + '" data-qty="' + toQty + '"' +
      ' data-product="' + item.product_id + '" data-options="' + esc(optionsSignature(item)) + '"' +
      ' aria-label="' + esc(label) + '">' +
      '<svg width="17" height="17" viewBox="0 0 20.4 20.4" aria-hidden="true" focusable="false" fill="none"' +
      ' stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" stroke-miterlimit="10">' +
      path + '</svg></button>';
  }

  function bindSteppers() {
    var buttons = itemsEl.querySelectorAll('.cart-dropdown__stepper');
    for (var i = 0; i < buttons.length; i++) {
      buttons[i].addEventListener('click', onStepperClick);
    }
  }

  function onStepperClick(e) {
    e.preventDefault();
    e.stopPropagation();
    if (e.stopImmediatePropagation) e.stopImmediatePropagation();
    var btn = e.currentTarget;
    setQuantity({
      key: btn.getAttribute('data-key'),
      line: btn.getAttribute('data-line'),
      qty: btn.getAttribute('data-qty'),
      productId: btn.getAttribute('data-product'),
      options: btn.getAttribute('data-options') || ''
    });
  }

  function render(cart) {
    renderCount(cart);

    if (!cart.items || !cart.items.length) {
      itemsEl.innerHTML = '<p class="cart-dropdown__empty">Your shopping cart is empty.</p>';
      footEl.innerHTML  = '<button type="button" class="cart-dropdown__btn cart-dropdown__btn--secondary" data-cart-close>Continue Shopping</button>';
      if (isOpen) position();
      return;
    }

    var html = '';
    for (var i = 0; i < cart.items.length; i++) html += renderItem(cart.items[i], i + 1);
    itemsEl.innerHTML = html;
    bindSteppers();

    footEl.innerHTML = '' +
      '<div class="cart-dropdown__total">' +
        '<span>Total</span>' +
        '<span>' + money(cart.total_price, false) + '</span>' +
      '</div>' +
      '<a href="/checkout" class="cart-dropdown__btn cart-dropdown__btn--primary">Checkout</a>' +
      '<button type="button" class="cart-dropdown__btn cart-dropdown__btn--secondary" data-cart-close>Continue Shopping</button>';

    // Content height just changed; keep the panel anchored.
    if (isOpen) position();
  }

  // The old updaters used html.replace(/[0-9]+/, count), which silently did
  // nothing when the label read "Cart" with no digit in it — so the count never
  // appeared after the first add. Write the label outright instead.
  function renderCount(cart) {
    var n = (cart && cart.item_count) || 0;

    var eyebrow = document.getElementById('eyebrow-cart');
    if (eyebrow) eyebrow.textContent = n > 0 ? 'Cart: ' + n : 'Cart';

    var bubbles = document.querySelectorAll('.cart-count');
    for (var i = 0; i < bubbles.length; i++) {
      bubbles[i].textContent = n > 0 ? String(n) : '';
      bubbles[i].style.display = n > 0 ? '' : 'none';
    }
  }

  /* ---------- data ---------- */

  function fetchCart() {
    return fetch('/cart.js', { credentials: 'same-origin' })
      .then(function(r) { return r.json(); });
  }

  function refresh() {
    return fetchCart().then(function(cart) { render(cart); return cart; });
  }

  function postCart(url, payload) {
    if (window.jQuery) {
      return window.jQuery.ajax({
        type: 'POST',
        url: url,
        dataType: 'json',
        data: payload
      });
    }

    var body = new URLSearchParams();
    Object.keys(payload).forEach(function(k) {
      if (payload[k] != null) body.set(k, String(payload[k]));
    });

    return fetch(url, {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Accept': 'application/json' },
      body: body
    }).then(function(r) {
      return r.json().then(function(data) {
        if (!r.ok) throw data || new Error('Cart update failed');
        return data;
      });
    });
  }

  function findLineItem(cart, key, line) {
    if (!cart || !cart.items) return null;
    if (key && key !== 'undefined') {
      for (var i = 0; i < cart.items.length; i++) {
        if (cart.items[i].key === key) return { item: cart.items[i], line: i + 1 };
      }
    }
    line = parseInt(line, 10);
    if (line >= 1 && cart.items[line - 1]) {
      return { item: cart.items[line - 1], line: line };
    }
    return null;
  }

  function findMatchingLines(cart, productId, optSig) {
    var matches = [];
    if (!cart || !cart.items || !productId) return matches;
    productId = parseInt(productId, 10);
    for (var i = 0; i < cart.items.length; i++) {
      var it = cart.items[i];
      if (isGwp(it)) continue;
      if (parseInt(it.product_id, 10) !== productId) continue;
      if (optionsSignature(it) !== optSig) continue;
      matches.push({ line: i + 1, item: it });
    }
    return matches;
  }

  // Remove matching lines from highest index → lowest, then add one clean row.
  // Avoids /cart/change.js on Bold Quantity Break products, which can spawn a
  // second hidden-tier variant instead of bumping qty on the existing line.
  function replaceQuantity(refItem, targetQty) {
    return fetchCart().then(function(cart) {
      var matches = findMatchingLines(cart, refItem.product_id, optionsSignature(refItem));
      if (!matches.length) {
        matches = [{ line: null, item: refItem }];
      }

      var variantId = refItem.variant_id;
      var chain = Promise.resolve();

      // Clear every matching row (end → start so indexes stay valid).
      for (var j = matches.length - 1; j >= 0; j--) {
        (function(m) {
          chain = chain.then(function() {
            if (m.item && m.item.key) {
              return postCart('/cart/change.js', { id: String(m.item.key), quantity: 0 });
            }
            if (m.line) {
              return postCart('/cart/change.js', { line: m.line, quantity: 0 });
            }
          });
        })(matches[j]);
      }

      if (targetQty > 0) {
        chain = chain.then(function() {
          return postCart('/cart/add.js', { id: variantId, quantity: targetQty });
        });
      }

      return chain;
    });
  }

  function setQuantity(opts) {
    if (busy) return;
    var key = opts.key;
    var line = parseInt(opts.line, 10);
    var qty = parseInt(opts.qty, 10);

    if (isNaN(qty) || qty < 0) return;
    if ((!key || key === 'undefined') && (!line || line < 1)) return;

    busy = true;
    panel.classList.add('is-busy');

    // Minus-to-zero: remove ONLY this line. Never collapse the whole product
    // group to 0 (that was wiping both duplicate outerwear rows at once).
    if (qty === 0) {
      var removePayload = (key && key !== 'undefined')
        ? { id: String(key), quantity: 0 }
        : { line: line, quantity: 0 };

      Promise.resolve(postCart('/cart/change.js', removePayload))
        .then(function() { showError(null); return refresh(); })
        .catch(function() {
          showError('Sorry — we could not update your cart. Please try again.');
          return refresh().catch(function() {});
        })
        .then(function() {
          busy = false;
          panel.classList.remove('is-busy');
        });
      return;
    }

    // Plus / non-zero qty: clear every identical product+option row, then add
    // a single line at the requested quantity (works around Bold QB splits).
    var keptProductId = opts.productId;
    var keptOptSig = opts.options || '';

    fetchCart()
      .then(function(cart) {
        var found = findLineItem(cart, key, line);
        if (!found) throw new Error('Line not found');
        keptProductId = found.item.product_id;
        keptOptSig = optionsSignature(found.item);
        return replaceQuantity(found.item, qty);
      })
      .then(function() { showError(null); return fetchCart(); })
      .then(function(cart) {
        // If an app still split the add into two rows, keep one at `qty`.
        var matches = findMatchingLines(cart, keptProductId, keptOptSig);
        if (matches.length <= 1) {
          render(cart);
          return cart;
        }
        var chain = Promise.resolve(
          postCart('/cart/change.js', { id: String(matches[0].item.key), quantity: qty })
        );
        for (var j = matches.length - 1; j >= 1; j--) {
          (function(itemKey) {
            chain = chain.then(function() {
              return postCart('/cart/change.js', { id: String(itemKey), quantity: 0 });
            });
          })(matches[j].item.key);
        }
        return chain.then(refresh);
      })
      .catch(function() {
        showError('Sorry — we could not update your cart. Please try again.');
        return refresh().catch(function() {});
      })
      .then(function() {
        busy = false;
        panel.classList.remove('is-busy');
      });
  }

  function showError(msg) {
    if (!msg) {
      errEl.hidden = true;
      errEl.textContent = '';
      return;
    }
    errEl.textContent = msg;
    errEl.hidden = false;
  }

  /* ---------- open / close ---------- */

  var closeTimer = null;
  var TRANSITION_MS = 280;

  function prefersReducedMotion() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function finishClose() {
    closeTimer = null;
    if (isOpen) return;
    panel.hidden = true;
    showError(null);
  }

  function open() {
    // Reposition even when already open — the viewport or the anchor may have
    // moved since the panel was last placed.
    var wasOpen = isOpen;
    isOpen = true;

    if (window.AdsumSearch && window.AdsumSearch.isOpen && window.AdsumSearch.isOpen()) {
      window.AdsumSearch.close();
    }

    if (closeTimer) {
      window.clearTimeout(closeTimer);
      closeTimer = null;
    }

    panel.hidden = false;
    position();

    // Reflow so the browser paints the closed styles before we open, otherwise
    // the enter transition is skipped.
    void panel.offsetWidth;
    panel.classList.add('is-open');

    var els = toggleEls();
    for (var i = 0; i < els.length; i++) {
      els[i].classList.add('is-open');
      els[i].setAttribute('aria-expanded', 'true');
    }
    // Only on an actual open, so a re-open never steals focus mid-interaction.
    if (!wasOpen) panel.focus();
  }

  function close() {
    if (!isOpen) return;
    isOpen = false;
    panel.classList.remove('is-open');

    var els = toggleEls();
    for (var i = 0; i < els.length; i++) {
      els[i].classList.remove('is-open');
      els[i].setAttribute('aria-expanded', 'false');
    }

    if (prefersReducedMotion()) {
      finishClose();
      return;
    }

    if (closeTimer) window.clearTimeout(closeTimer);
    closeTimer = window.setTimeout(finishClose, TRANSITION_MS);
  }

  function toggle() {
    if (isOpen) { close(); return; }
    open();
    refresh().catch(function() {});
  }

  /* ---------- events ---------- */

  // Recorded in the capture phase, before any other handler can react to this
  // same click. Without it, a click that opens the panel would immediately be
  // treated as an outside-click by the bubble handler below and close it again.
  var wasOpenOnClick = false;
  document.addEventListener('click', function() { wasOpenOnClick = isOpen; }, true);

  document.addEventListener('click', function(e) {
    var toggler = e.target.closest && e.target.closest('#eyebrow-cart, .mobile-cart');
    if (toggler) {
      e.preventDefault();
      toggle();
      return;
    }

    var closer = e.target.closest && e.target.closest('[data-cart-close]');
    if (closer) {
      e.preventDefault();
      close();
      return;
    }

    // Qty steppers bind their own click handlers in bindSteppers() — don't
    // also handle them here (avoids double-firing with document delegation).
    if (e.target.closest && e.target.closest('.cart-dropdown__stepper')) {
      return;
    }

    if (wasOpenOnClick && isOpen && !panel.contains(e.target)) close();
  });

  document.addEventListener('keydown', function(e) {
    if (e.key !== 'Escape' && e.keyCode !== 27) return;
    if (!isOpen) return;
    var anchor = document.getElementById('eyebrow-cart') || document.querySelector('.mobile-cart');
    close();
    if (anchor && anchor.focus) anchor.focus();
  });

  window.addEventListener('scroll', schedulePosition, true);
  window.addEventListener('resize', schedulePosition);

  // gwp-cart-banner auto-adds the free hat ~500ms after a qualifying add and
  // dispatches this event. Without it the panel goes stale as soon as it opens.
  document.addEventListener('cart:refresh', function() {
    if (busy) return;
    refresh().catch(function() {});
  });

  // Note: the header count is seeded server-side by Liquid, and refreshed on
  // load by gwp-cart-banner's own /cart.js call (which hands the cart to
  // renderCount). Deliberately no extra request from here.

  window.AdsumCart = {
    open: open,
    close: close,
    toggle: toggle,
    render: render,
    refresh: refresh,
    renderCount: renderCount,
    showError: showError,
    isOpen: function() { return isOpen; }
  };
})();
</script>
