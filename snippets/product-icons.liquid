<style>
  .icon-grid-container{
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding: 38px 50px 24px 246px;
    column-gap: 40px;  
    row-gap: 40px;
  }
  .icon-three-layer > svg {
    width: 100%;
    max-height: 340px;
  }
  .icon-overdyed > svg {
    width: 100%;
    max-height: 300px;
  }
  .features-heading {
    grid-column: span 4;
    padding: 50px 0px 20px 0px;
    text-align: left;
    font-weight: 700;
    font-size: 18px;
  }
  .features-copy {
    grid-column: span 1;
  }
  .features-copy p  {
    max-width: 420px;
  }
  .features-copy h2 {
    font-size: 12px;
    padding-bottom: 10px;
  }
  .icon {
    grid-column: span 1;
  }
@media (max-width: 900px){
  .icon-grid-container{
    padding: 76px 12px 76px 12px;
  }
  .icon-container{
    grid-column: span 3;
    max-width: 500px;
  }
}

@media (max-width: 600px){
  .icon-grid-container {
    padding: 76px 12px 76px 12px;
  }
  .icon-container {
    grid-column: span 6;
    max-width: 500px;
  } 
}
</style>


<div class="icon-grid-container">
  <h1 class="features-heading">
    Features
  </h1>

  <!--   3-Layer   -->
  {% if product.tags contains 'icon-3-layer' %}
    <div class="features-copy">
      <h2>3-Layer Technology</h2>
      <p class="features-copy">
        Three layer technology is some of our most sophisticated we harness in our outerwear. Not only is it water and weatherproof but it also allows your body to breath and remain dry. When the weather gets bad, we wouldn’t leave the house in anything that doesn’t have it.
      </p>
    </div>
    <div class="icon icon-three-layer">
      {% include "3-layer-icon" %}
    </div>
    
  {% endif %}

  <!--   OVERDYED  -->   
  {% if product.tags contains 'icon-overdyed' %}
  <div class="features-copy">
    <h2>Overdyed</h2>
    <p class="features-copy">
      Each individual item is whole garment dyed for a soft color uptake.
    </p>
  </div>
  <div class="icon icon-overdyed">
    {% include "icon-overdyed" %}
  </div>
  
  {% endif %}

  
  <!--   RECYCLED FILL   -->
  {% if product.tags contains 'icon-recycled-fill' %}
    <div class="three-layer">
