<style>
  .product-size {
    opacity: 0;
  }
  .collection-grid-item a:hover .product-size {
    opacity: 1;
      -moz-transition: all .1s ease-in-out;
      -webkit-transition: all .1s ease-in-out;
      -o-transition: all .1s ease-in-out;
      -ms-transition: all .1s ease-in-out;
      transition: all .1s ease-in-out;
  }
  /* .collection-grid-item a:hover .gallery-product-title, .collection-grid-item a:hover .gallery-product-price {
    opacity: 0;
    visibility: hidden;
    display: none;
  } */
  .product-exclusive {
    color: #000;
      background-color: none;
     position: absolute;
     bottom: 11px;
     right: 10px;
     padding: 2px 12px;
     font-size: 11px;
     border-radius: 15px;
  }
  /* Products tagged 'coming-soon': dimmed image with a centred label, no hover swap */
  .product-coming-soon {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(43, 43, 43, 0.25);
    color: #fff;
    font-size: 16px;
    line-height: 1.28571;
    z-index: 1;
  }
  .collection-grid-item.is-coming-soon .collection-product-hover {
    display: none;
  }
  @media (max-width:900px) {
    .product-coming-soon {
      font-size: 13px;
    }
    .product-exclusive {
      color: #000;
      background-color: none;
      position: absolute;
      bottom: 11px;
      right: 9px;
      padding: 0px 9px;
      font-size: 9px;
      border-radius: 15px;
    }
    .product-size {
      opacity: 1;
    }
    .collection-grid-item a:hover .gallery-product-title, .collection-grid-item a:hover .gallery-product-price {
      opacity: 1;
      visibility: visible;
      display: block;
    }
  }
</style>

{% comment %}
  Two passes so products tagged 'coming-soon' always sit after everything else,
  whatever sort order the collection uses.
{% endcomment %}
{% for gallery_pass in (1..2) %}
{% for product in collection.products %}

{% assign coming_soon = false %}
{% if product.tags contains 'coming-soon' %}
  {% assign coming_soon = true %}
{% endif %}
{% if gallery_pass == 1 and coming_soon %}{% continue %}{% endif %}
{% if gallery_pass == 2 and coming_soon == false %}{% continue %}{% endif %}

{% if template == 'collection.sidebar' %}
<div class="product4 {% cycle '', '' %}">
{% else %}
<div class="collection-grid-item {{ product.tags | downcase }}{% if coming_soon %} is-coming-soon{% endif %}">
{% endif %}

  <a href="{{ product.url | within: collection }}" title="{{ product.title | strip_html | escape }}">
	<div style="position: relative;">
      {% if product.tags contains 'exclusive' %}
          <div class="product-exclusive">
            Adsum Exclusive
          </div>
        {% endif %}
      {% if coming_soon %}
          <div class="product-coming-soon">Coming Soon</div>
        {% endif %}
      <img data-sizes="auto"
           src="{{ product.images.first | product_img_url: '1x1' }}" 
           data-src="{{ product.images.first | product_img_url: '1024x1024' }}"
           data-srcset="{{ product.images.first | product_img_url: '600x600' }} 300w,
    					{{ product.images.first | product_img_url: '1200x1200' }} 600w,
    					{{ product.images.first | product_img_url: '1800x1800' }} 900w"
           alt="{{ product.title | strip_html | escape }}" class="lazyload" style="display: block; width: 100%; height: 100%;" />
      <img data-sizes="auto"
           src="{{ product.images[1] | product_img_url: '1x1' }}" 
           data-src="{{ product.images[1] | product_img_url: '1024x1024' }}" 
           data-srcset="{{ product.images[1] | product_img_url: '600x600' }} 300w,
    					{{ product.images[1] | product_img_url: '1200x1200' }} 600w,
    					{{ product.images[1] | product_img_url: '1800x1800' }} 900w"
           alt="{{ product.images[1].alt | escape }}" class="collection-product-hover lazyload"/>
    </div>
	<div class="product_info_content">
		{% if coming_soon %}
			<div class="gallery-product-title">
				{{ product.title }}
			</div>
		{% else %}
		{%if product.available == true %}
			<div class="gallery-product-title">
				{{ product.title }}
			</div>
			<div class="gallery-product-price">
				{% if product.compare_at_price_max > product.price %}
                	<del class="sale-price">{{ product.compare_at_price_max | money }}</del>
                {% endif %}
                {{ product.price | money }}
			</div>
      
		<div class="product-size">
                {% assign first_color = product.variants.first.option1 %}
                {% assign has_multiple_colors = false %}
                {% for variant in product.variants %}
                  {% if variant.option1 != first_color %}
                    {% assign has_multiple_colors = true %}
                    {% break %}
                  {% endif %}
                {% endfor %}
                <ul id="variants">
                  {% for variant in product.variants %}
                  {% unless product.title contains 'Diamond Popover' and variant.title == 'BLACK / S' %}
                  <li style="display: relative;">
                    {% if variant.available == true %}
                    <input type="radio" name="id" value="{{variant.id}}" id="radio_{{variant.id}}" {%if forloop.first%} {%endif%} />
                    <label for="radio_{{variant.id}}">

                      <div class='variant_title'>{% if has_multiple_colors %}{{ variant.title }}{% else %}{{ variant.title | split: ' / ' | last }}{% endif %}</div>
                      {% assign variant = product.variants.first %}
                      {% if variant.available %}
                      {% if variant.inventory_management != ''  %}
                      {% else %}
                      {% endif %}
                      {% endif %}
                    </label>        
                    {% else %}
                    <span class="sold_out">{% if has_multiple_colors %}{{ variant.title }}{% else %}{{ variant.title | split: ' / ' | last }}{% endif %}</span>
                    {% endif %}
                  </li>
                  {% endunless %}
                  {% endfor %}
                </ul>
        </div>
		
		{% endif %}
		{%if product.available == false %}    
			<span style="text-decoration: uppercase;">Sold Out</span>
		{% endif %}
		{% endif %}

	</div>
  </a>

</div>
{% endfor %}
{% endfor %}
  
<style>
.variant_title {
  display: inline;
}
</style>