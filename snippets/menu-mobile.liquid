{%- comment -%}
  Mobile nav dropdown (Paper "Nav Dropdown").
  Top-level links are underlined; children sit in a 20px-gap stack below.
  Search / cart live in the header bar — not in this panel.
{%- endcomment -%}

<nav class="mobile-nav-dropdown" aria-label="Mobile navigation">
  {% for link in linklists.main-menu.links %}
    {%- assign link_handle = link.title | downcase | strip -%}
    {% unless link_handle == 'lookbooks' %}
      <div class="mobile-nav-section">
        <a href="{{ link.url }}" class="mobile-nav-parent {{ link_handle }}">{{ link.title }}</a>

        {% if link.links.size > 0 %}
          <div class="mobile-nav-children">
            {% for child_link in link.links %}
              <a href="{{ child_link.url }}" class="mobile-nav-child {{ child_link.title | downcase }}">{{ child_link.title }}</a>
              {% if child_link.links.size > 0 %}
                {% for grandchild_link in child_link.links %}
                  <a href="{{ grandchild_link.url }}" class="mobile-nav-child {{ grandchild_link.title | downcase }}">{{ grandchild_link.title }}</a>
                {% endfor %}
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    {% endunless %}
  {% endfor %}
</nav>
